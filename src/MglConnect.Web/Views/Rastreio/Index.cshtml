@model MglConnect.Web.ViewModels.RastreioViewModel
@{
    ViewData["Title"] = "Rastreamento de Encomenda - Estilo Mercado Livre";

    int stepNumber = 1;
    int progressPercent = 10;

    if (Model.Entrega != null)
    {
        var eventos = Model.Entrega.EventosRastreio.ToList();
        var status = Model.Entrega.StatusEntrega;

        if (status == "Entregue")
        {
            stepNumber = 5;
            progressPercent = 100;
        }
        else if (eventos.Any(e => e.Titulo.Contains("Saiu para entrega", StringComparison.OrdinalIgnoreCase)))
        {
            stepNumber = 4;
            progressPercent = 75;
        }
        else if (status == "Em transporte" || eventos.Count > 1)
        {
            stepNumber = 3;
            progressPercent = 50;
        }
        else
        {
            stepNumber = 2;
            progressPercent = 25;
        }
    }
}

<div class="container py-4">
    <!-- Barra Superior de Consulta -->
    <div class="card-mgl p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-lg-5 mb-3 mb-lg-0">
                <h4 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: var(--mgl-dark-primary);">
                    <i class="bi bi-geo-alt-fill text-warning"></i> Rastreamento de Encomendas
                </h4>
                <p class="text-muted small mb-0">Consulte o status operacional detalhado e a timeline em tempo real.</p>
            </div>
            <div class="col-lg-7">
                <form asp-controller="Rastreio" asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="codigo" value="@Model.CodigoBuscado" 
                               class="form-control form-control-lg fs-6" 
                               placeholder="Exemplo: MGL-BR100201..." required />
                        <button class="btn btn-mgl-teal fw-bold px-4" type="submit">
                            <i class="bi bi-search me-1"></i> Consultar Carga
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!Model.Pesquisado)
    {
        <!-- Estado inicial: Nenhuma busca feita -->
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-3">
                <i class="bi bi-box-seam"></i>
            </div>
            <h5 class="fw-bold text-secondary">Acompanhe seu pacote passo a passo</h5>
            <p class="text-muted small max-w-md mx-auto">
                Insira o código de rastreamento fornecido pela M.G.L Logística para acompanhar a linha do tempo e a rota de entrega.
            </p>
            <div class="mt-4">
                <span class="text-muted small me-2">Dica: teste um dos códigos cadastrados:</span>
                <a asp-action="Index" asp-route-codigo="MGL-BR100201" class="btn btn-outline-primary btn-sm me-2">MGL-BR100201 (Em Rota)</a>
                <a asp-action="Index" asp-route-codigo="MGL-BR200302" class="btn btn-outline-success btn-sm">MGL-BR200302 (Entregue c/ POD)</a>
            </div>
        </div>
    }
    else if (Model.Entrega == null)
    {
        <!-- Pacote Não Encontrado -->
        <div class="card-mgl p-5 text-center">
            <div class="text-warning mb-3 display-4">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h4 class="fw-bold text-dark">Código de Rastreio Não Localizado</h4>
            <p class="text-muted small mb-4">@Model.MensagemErro</p>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-4">Tentar novamente</a>
            </div>
        </div>
    }
    else
    {
        <!-- VISUALIZAÇÃO ESTILO MERCADO LIVRE -->
        <div class="card-mgl p-4 p-md-5 mb-4">
            
            <!-- Cabeçalho do Rastreio -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom pb-4 mb-4">
                <div>
                    @if (Model.Entrega.StatusEntrega == "Entregue")
                    {
                        <span class="badge badge-mgl-delivered px-3 py-2 rounded-pill fw-bold fs-7 mb-2 d-inline-block">
                            <i class="bi bi-patch-check-fill me-1"></i> Pacote Entregue com Sucesso (POD Arquivado)
                        </span>
                        <h2 class="fw-extrabold text-success mb-1">
                            Entregue em @Model.Entrega.DataEntregaRealizada?.ToString("dd/MM/yyyy às HH:mm")
                        </h2>
                    }
                    else if (Model.Entrega.StatusEntrega == "Em transporte")
                    {
                        <span class="badge badge-mgl-transit px-3 py-2 rounded-pill fw-bold fs-7 mb-2 d-inline-block">
                            <i class="bi bi-truck me-1"></i> Carga em Trânsito
                        </span>
                        <h2 class="fw-extrabold mb-1" style="color: var(--mgl-dark-primary);">
                            Previsão de entrega: @(Model.Entrega.DataPrevisaoEntrega?.ToString("dd 'de' MMMM") ?? "Em breve")
                        </h2>
                    }
                    else
                    {
                        <span class="badge badge-mgl-pending px-3 py-2 rounded-pill fw-bold fs-7 mb-2 d-inline-block">
                            <i class="bi bi-hourglass-split me-1"></i> Em Preparação no Centro Logístico
                        </span>
                        <h2 class="fw-extrabold mb-1" style="color: var(--mgl-dark-primary);">
                            Aguardando despacho rodoviário
                        </h2>
                    }

                    <div class="text-muted fs-7 d-flex align-items-center gap-2 flex-wrap">
                        <span>Destino: <strong class="text-dark">@Model.Entrega.CidadeDestino/@Model.Entrega.EstadoDestino</strong></span> • 
                        <span>Destinatário: <span class="text-dark">@Model.Entrega.DestinatarioNome</span></span>
                        <span class="signalr-live-badge"><span class="live-dot"></span> WebSocket Conectado</span>
                    </div>
                </div>

                <!-- Card de Código e Botão Copiar -->
                <div class="p-3 rounded-4 border text-end" style="background-color: var(--mgl-bg);">
                    <div class="text-muted fs-8 text-uppercase fw-bold mb-1">Código de Rastreamento</div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5 fw-extrabold tracking-wider font-monospace" style="color: var(--mgl-accent-2);">@Model.Entrega.CodigoRastreio</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" 
                                onclick="copiarCodigoRastreio('@Model.Entrega.CodigoRastreio', this)" title="Copiar código">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEPPER HORIZONTAL ESTILO MERCADO LIVRE -->
            <div class="px-2 px-md-4 py-2">
                <div class="ml-stepper">
                    <div class="ml-stepper-progress" style="width: calc(@progressPercent% - 50px);"></div>
                    
                    <div class="ml-step-item @(stepNumber >= 1 ? (stepNumber == 1 ? "active" : "completed") : "")">
                        <div class="ml-step-circle">
                            <i class="bi @(stepNumber > 1 ? "bi-check-lg" : "bi-file-earmark-check")"></i>
                        </div>
                        <div class="ml-step-title">Pedido Confirmado</div>
                        <div class="ml-step-subtitle">@Model.Entrega.DataCriacao.ToString("dd/MM")</div>
                    </div>

                    <div class="ml-step-item @(stepNumber >= 2 ? (stepNumber == 2 ? "active" : "completed") : "")">
                        <div class="ml-step-circle">
                            <i class="bi @(stepNumber > 2 ? "bi-check-lg" : "bi-box-seam")"></i>
                        </div>
                        <div class="ml-step-title">No Centro Logístico</div>
                        <div class="ml-step-subtitle">Bipado & Conferido</div>
                    </div>

                    <div class="ml-step-item @(stepNumber >= 3 ? (stepNumber == 3 ? "active" : "completed") : "")">
                        <div class="ml-step-circle">
                            <i class="bi @(stepNumber > 3 ? "bi-check-lg" : "bi-truck")"></i>
                        </div>
                        <div class="ml-step-title">A Caminho</div>
                        <div class="ml-step-subtitle">Corredor Rodoviário</div>
                    </div>

                    <div class="ml-step-item @(stepNumber >= 4 ? (stepNumber == 4 ? "active" : "completed") : "")">
                        <div class="ml-step-circle">
                            <i class="bi @(stepNumber > 4 ? "bi-check-lg" : "bi-bicycle")"></i>
                        </div>
                        <div class="ml-step-title">Saiu para Entrega</div>
                        <div class="ml-step-subtitle">Com o motorista</div>
                    </div>

                    <div class="ml-step-item @(stepNumber == 5 ? "completed" : "")">
                        <div class="ml-step-circle">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>
                        <div class="ml-step-title">Entregue</div>
                        <div class="ml-step-subtitle">@(Model.Entrega.DataEntregaRealizada?.ToString("dd/MM") ?? "Destino final")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CONTEÚDO PRINCIPAL: TIMELINE + DETALHES -->
        <div class="row g-4">
            <!-- Coluna Esquerda: Linha do Tempo de Checkpoints (Mercado Livre Timeline) -->
            <div class="col-lg-8">
                <div class="card-mgl p-4">
                    <h5 class="fw-bold mb-4 d-flex align-items-center gap-2" style="color: var(--mgl-dark-primary);">
                        <i class="bi bi-clock-history text-primary"></i> Histórico de Movimentações em Tempo Real
                    </h5>

                    <div class="tracking-timeline" id="publicTimeline">
                        @{
                            var eventosOrdenados = Model.Entrega.EventosRastreio.OrderByDescending(e => e.DataHora).ToList();
                            bool isFirst = true;
                        }

                        @foreach (var ev in eventosOrdenados)
                        {
                            var classeDestaque = isFirst 
                                ? (Model.Entrega.StatusEntrega == "Entregue" ? "delivered" : "latest") 
                                : "";
                            
                            <div class="timeline-event @classeDestaque">
                                <div class="timeline-icon-box">
                                    <i class="bi @ev.Icone"></i>
                                </div>
                                <div class="timeline-card">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold mb-0" style="color: var(--mgl-dark-primary);">@ev.Titulo</h6>
                                        <span class="badge bg-light text-secondary border fs-8">
                                            @ev.DataHora.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ev.Descricao))
                                    {
                                        <p class="text-secondary small mb-2">@ev.Descricao</p>
                                    }
                                    <div class="d-flex align-items-center gap-2 text-muted fs-8">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>@ev.Localidade</span>
                                    </div>
                                </div>
                            </div>

                            isFirst = false;
                        }
                    </div>
                </div>
            </div>

            <!-- Coluna Direita: Informações do Pacote, POD e Destino -->
            <div class="col-lg-4">
                <!-- Comprovante Digital de Entrega (POD) -->
                @if (Model.Entrega.StatusEntrega == "Entregue" && !string.IsNullOrEmpty(Model.Entrega.NomeRecebedor))
                {
                    <div class="card-mgl p-4 mb-4 border-success" style="border-width: 2px;">
                        <h6 class="fw-bold text-success mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-patch-check-fill fs-5"></i> Comprovante de Entrega (POD)
                        </h6>
                        <ul class="list-unstyled fs-7 mb-3">
                            <li class="mb-1"><strong>Recebido por:</strong> @Model.Entrega.NomeRecebedor</li>
                            @if (!string.IsNullOrEmpty(Model.Entrega.DocumentoRecebedor))
                            {
                                <li class="mb-1"><strong>Documento:</strong> @Model.Entrega.DocumentoRecebedor</li>
                            }
                            <li class="mb-1"><strong>Data e Hora:</strong> @Model.Entrega.DataHoraRecebimento?.ToString("dd/MM/yyyy HH:mm")</li>
                        </ul>
                        @if (!string.IsNullOrEmpty(Model.Entrega.AssinaturaDigitalBase64))
                        {
                            <div class="p-2 bg-light rounded-3 text-center border">
                                <div class="text-muted fs-8 mb-1">Assinatura Digital Coletada:</div>
                                <img src="@Model.Entrega.AssinaturaDigitalBase64" alt="Assinatura Digital" style="max-height: 70px; max-width: 100%;" />
                            </div>
                        }
                    </div>
                }

                <!-- Card de Destino -->
                <div class="card-mgl p-4 mb-4">
                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-2" style="color: var(--mgl-dark-primary);">
                        <i class="bi bi-house-door text-warning"></i> Endereço de Entrega
                    </h6>
                    <div class="fs-7 mb-2">
                        <strong class="d-block text-dark">@Model.Entrega.DestinatarioNome</strong>
                        @if (!string.IsNullOrEmpty(Model.Entrega.DestinatarioDocumento))
                        {
                            <span class="text-muted fs-8">Doc: @Model.Entrega.DestinatarioDocumento</span>
                        }
                    </div>
                    <div class="text-muted fs-7">
                        @Model.Entrega.EnderecoDestino, @Model.Entrega.NumeroDestino 
                        @if (!string.IsNullOrEmpty(Model.Entrega.ComplementoDestino))
                        {
                            <span>- @Model.Entrega.ComplementoDestino</span>
                        }
                        <br />
                        @Model.Entrega.BairroDestino • @Model.Entrega.CidadeDestino / @Model.Entrega.EstadoDestino
                        <br />
                        <span class="font-monospace">CEP: @Model.Entrega.CepDestino</span>
                    </div>
                </div>

                <!-- Card da Operação / Pedido -->
                <div class="card-mgl p-4">
                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-2" style="color: var(--mgl-dark-primary);">
                        <i class="bi bi-info-circle text-primary"></i> Detalhes da Operação
                    </h6>
                    <ul class="list-unstyled fs-7 mb-0">
                        <li class="mb-2 pb-2 border-bottom d-flex justify-content-between">
                            <span class="text-muted">Transportadora:</span>
                            <strong style="color: var(--mgl-dark-primary);">M.G.L Logística S.A.</strong>
                        </li>
                        @if (Model.Entrega.Pedido != null)
                        {
                            <li class="mb-2 pb-2 border-bottom d-flex justify-content-between">
                                <span class="text-muted">Número do Pedido:</span>
                                <strong style="color: var(--mgl-dark-primary);">@Model.Entrega.Pedido.NumeroPedido</strong>
                            </li>
                            <li class="mb-2 pb-2 border-bottom d-flex justify-content-between">
                                <span class="text-muted">Peso do Pacote:</span>
                                <span>@Model.Entrega.Pedido.PesoKg.ToString("F1") kg</span>
                            </li>
                        }
                        @if (Model.Entrega.Motorista != null)
                        {
                            <li class="mb-2 pb-2 border-bottom d-flex justify-content-between">
                                <span class="text-muted">Motorista:</span>
                                <span>@Model.Entrega.Motorista.Nome</span>
                            </li>
                        }
                        @if (Model.Entrega.Veiculo != null)
                        {
                            <li class="mb-2 pb-2 border-bottom d-flex justify-content-between">
                                <span class="text-muted">Veículo Frota:</span>
                                <span>@Model.Entrega.Veiculo.Modelo</span>
                            </li>
                        }
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Data de Postagem:</span>
                            <span>@Model.Entrega.DataCriacao.ToString("dd/MM/yyyy")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (Model.Entrega != null)
    {
        <script>
            // Escuta WebSocket SignalR para Atualização ao Vivo
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/trackingHub")
                .withAutomaticReconnect()
                .build();

            const joinTrackingGroup = () => connection.invoke("JoinTrackingGroup", "@Model.Entrega.CodigoRastreio");
            connection.onreconnected(joinTrackingGroup);
            connection.on("ReceiveCheckpointUpdate", (data) => {
                const container = document.getElementById("publicTimeline");
                if (container) {
                    const newEventHtml = `
                        <div class="timeline-event latest animate__animated animate__fadeInDown">
                            <div class="timeline-icon-box">
                                <i class="bi ${data.icone}"></i>
                            </div>
                            <div class="timeline-card" style="border-left: 4px solid var(--mgl-teal);">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold mb-0" style="color: var(--mgl-dark-primary);">${data.titulo}</h6>
                                    <span class="badge bg-light text-secondary border fs-8">${data.dataHora}</span>
                                </div>
                                <p class="text-secondary small mb-2">${data.descricao || ''}</p>
                                <div class="d-flex align-items-center gap-2 text-muted fs-8">
                                    <i class="bi bi-geo-alt"></i>
                                    <span>${data.localidade}</span>
                                </div>
                            </div>
                        </div>
                    `;
                    container.insertAdjacentHTML('afterbegin', newEventHtml);
                }
            });

            connection.start().then(joinTrackingGroup).then(() => {
                console.log("Rastreamento conectado ao SignalR para: @Model.Entrega.CodigoRastreio");
            }).catch(err => console.error("SignalR:", err));
        </script>
    }
}
