@model ErrorViewModel
@{ ViewData["Title"] = "Operação não concluída"; }
<section class="cc-panel cc-empty-state" role="alert">
    <span class="cc-eyebrow">M.G.L CONNECT / OPERAÇÃO</span>
    <h1>Não foi possível concluir esta operação</h1>
    <p>Confira sua conexão e tente novamente. Se o problema continuar, informe a referência abaixo à administração.</p>
    @if(Model.ShowRequestId){<p>Referência: <code>@Model.RequestId</code></p>}
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar ao início</a>
</section>
