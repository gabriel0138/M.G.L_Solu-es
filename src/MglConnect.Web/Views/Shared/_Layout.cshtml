@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var admin = User.IsInRole("Admin");
    var driver = User.IsInRole("Motorista") && !admin;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var cockpit = driver && controller == "Entregas" && action == "Navegar";
    var shell = signedIn && !driver;
    var pageTitle = ViewData["Title"]?.ToString() ?? "M.G.L Connect";
    var homeLabel = admin ? "Operação" : "Meu portal";
    var homeLink = admin ? "/Dashboard" : "/Cliente";
    var bodyClass = shell ? "cc-shell" : driver ? "cc-driver-layout" : "cc-public-layout";
    if (driver && controller == "Entregas") bodyClass += " driver-experience";
    if (cockpit) bodyClass += " cc-driver-navigation";
}
<!DOCTYPE html>
<html lang="pt-BR" data-mgl-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>@pageTitle — M.G.L Connect</title>
    <meta name="theme-color" content="#080F1D" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MGL Connect" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <script src="~/js/command-center-theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/command-center.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gps-history.css" asp-append-version="true" />
    @if (driver)
    {
        <link rel="stylesheet" href="~/css/command-driver.css" asp-append-version="true" />
    }
    @if (controller == "ClientePortal")
    {
        <link rel="stylesheet" href="~/css/command-portal.css" asp-append-version="true" />
    }
    @if (controller == "Entregas" && action == "Navegar")
    {
        <link rel="stylesheet" href="~/css/command-cockpit.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass" data-sidebar-open="false">
    <a class="cc-skip-link" href="#mainContent">Pular para o conteúdo</a>
    @if (shell)
    {
        <partial name="_CommandNavigation" />
    }
    <div class="cc-workspace">
        @if (!cockpit)
        {
            <header class="@(shell ? "cc-topbar" : "cc-public-header")">
                @if (shell)
                {
                    <button type="button" class="cc-icon-button cc-mobile-menu" data-sidebar-toggle aria-controls="commandSidebar" aria-expanded="false" aria-label="Abrir navegação"><i class="bi bi-list" aria-hidden="true"></i></button>
                    <div class="cc-topbar-title">
                        <nav class="cc-breadcrumbs" aria-label="Localização"><a href="@homeLink">@homeLabel</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">@pageTitle</span></nav>
                    </div>
                }
                else
                {
                    <a class="cc-brand" href="/" aria-label="M.G.L Connect — página inicial"><span class="cc-brand-symbol" aria-hidden="true"><i class="bi bi-box-seam"></i></span><span><strong>M.G.L CONNECT</strong><small>Command Center</small></span></a>
                }
                <div class="cc-topbar-actions">
                    @if (shell)
                    {
                        <button type="button" class="cc-icon-button cc-command-trigger" data-command-open aria-controls="commandPalette" aria-haspopup="dialog" aria-label="Encontrar uma seção"><i class="bi bi-search" aria-hidden="true"></i><span>Encontrar seção</span><kbd>Ctrl K</kbd></button>
                    }
                    else if (!driver)
                    {
                        <a class="cc-public-tracking" asp-controller="Rastreio" asp-action="Index">Rastrear entrega</a>
                    }
                    <button type="button" class="cc-icon-button cc-theme-toggle" data-theme-toggle aria-label="Ativar modo claro" title="Ativar modo claro"><i class="bi bi-sun" data-theme-icon aria-hidden="true"></i></button>
                    @if (signedIn)
                    {
                        <partial name="_CommandAccount" />
                    }
                    else if (controller != "Account")
                    {
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Entrar</a>
                    }
                </div>
            </header>
        }
        <main id="mainContent" class="cc-main" tabindex="-1">
            @if (!cockpit && TempData["MensagemSucesso"] is string success)
            {
                <div class="cc-notification-host"><div class="alert alert-success alert-dismissible fade show" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> @success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar mensagem"></button></div></div>
            }
            @if (!cockpit && TempData["MensagemErro"] is string error)
            {
                <div class="cc-notification-host"><div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar mensagem"></button></div></div>
            }
            @if (driver && !cockpit)
            {
                <partial name="_DriverOfflineQueueState" model="false" />
            }
            @RenderBody()
        </main>
        @if (!cockpit && !driver)
        {
            <footer class="cc-footer"><span>M.G.L Connect <span aria-hidden="true">·</span> Command Center</span><span>Logística conectada à sua operação.</span></footer>
        }
    </div>
    @if (shell)
    {
        <dialog id="commandPalette" class="cc-command-palette" aria-labelledby="commandPaletteTitle">
            <div class="cc-panel-header"><h2 id="commandPaletteTitle" class="h5">Encontrar seção</h2><button type="button" class="cc-icon-button" data-command-close aria-label="Fechar busca"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <label for="commandSearch" class="visually-hidden">Buscar nas seções disponíveis para seu perfil</label>
            <input type="search" id="commandSearch" class="form-control cc-command-search" placeholder="Pedidos, viagens, rastreamento…" autocomplete="off" />
            <ul class="cc-command-options" data-command-options></ul>
            <p class="cc-command-empty" data-command-empty hidden>Nenhuma seção encontrada. Tente outro nome.</p>
        </dialog>
    }
    <div class="cc-toasts" id="commandToasts" aria-live="polite" aria-atomic="false"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.25/signalr.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/command-center.js" asp-append-version="true"></script>
    @if (driver)
    {
        <script src="~/js/driver-gps-queue.js" asp-append-version="true"></script>
        <script src="~/js/driver-gps.js" asp-append-version="true"></script>
        <script src="~/js/driver-pod-queue.js" asp-append-version="true"></script>
    }
    <script src="~/js/gps-history.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
        }
    </script>
</body>
</html>
