<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - M.G.L Logística Integrada S.A.</title>
    <!-- PWA Progressive Web App Manifest & Mobile Meta Tags -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0B132B" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="MGL Connect" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Leaflet CSS para Mapas de Roteamento -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Custom Design System CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 @(User.IsInRole("Motorista") && !User.IsInRole("Admin") && ViewContext.RouteData.Values["controller"]?.ToString() == "Entregas" ? "driver-experience" : "")">
    <!-- Navbar Corporativa M.G.L Dark -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-mgl bg-dark sticky-top py-2" style="background-color: #0B132B !important; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="brand-badge">
                    <i class="bi bi-box-seam-fill"></i> MGL
                </span>
                <span class="brand-text">M.G.L LOGÍSTICA INTEGRADA S.A.</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" 
                    aria-controls="navContent" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i> Início
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rastreio" ? "active text-warning" : "")" 
                           asp-controller="Rastreio" asp-action="Index" style="color: var(--mgl-amber) !important; font-weight: 600;">
                            <i class="bi bi-geo-alt-fill me-1"></i> Rastreamento ML
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roteamento" ? "active" : "")" 
                           asp-controller="Roteamento" asp-action="Index">
                            <i class="bi bi-truck-front-fill me-1" style="color: var(--mgl-teal);"></i> Roteamento Pesado
                        </a>
                    </li>
                    
                    @* Menu do Cliente (Admin ou Cliente) *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Cliente"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClientePortal" ? "active" : "")" 
                               asp-controller="ClientePortal" asp-action="Index">
                                <i class="bi bi-person-workspace me-1"></i> Área do Cliente
                            </a>
                        </li>
                    }

                    @* Menu de Motorista (Apenas se for Motorista e não Admin) *@
                    @if (User.IsInRole("Motorista") && !User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Entregas" ? "active" : "")" 
                               asp-controller="Entregas" asp-action="Index">
                                <i class="bi bi-truck me-1" style="color: var(--mgl-amber);"></i> Minhas Entregas & POD
                            </a>
                        </li>
                    }

                    @* Menu de Gestão Operacional Completa (Exclusivo Admin) *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-speedometer2 me-1"></i> Gestão Operacional
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow border-0" style="background-color: var(--mgl-dark-primary);">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-graph-up me-2 text-info"></i> Dashboard KPIs
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Clientes" asp-action="Index">
                                        <i class="bi bi-building me-2 text-warning"></i> Clientes Corporativos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Pedidos" asp-action="Index">
                                        <i class="bi bi-receipt me-2 text-success"></i> Pedidos de Carga
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Entregas" asp-action="Index">
                                        <i class="bi bi-truck me-2 text-primary"></i> Entregas & POD
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger" target="_blank" title="Swagger REST API">
                                <i class="bi bi-code-slash me-1"></i> API
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                                <span class="avatar-badge">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                                <span class="fw-semibold">@User.Identity.Name</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger text-white shadow-sm fs-8">
                                        <i class="bi bi-shield-fill-check me-1"></i> Admin
                                    </span>
                                }
                                else if (User.IsInRole("Motorista"))
                                {
                                    <span class="badge bg-warning text-dark shadow-sm fs-8">
                                        <i class="bi bi-truck-front-fill me-1"></i> Motorista
                                    </span>
                                }
                                else if (User.IsInRole("Cliente"))
                                {
                                    <span class="badge bg-info text-dark shadow-sm fs-8">
                                        <i class="bi bi-person-fill-check me-1"></i> Cliente
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-8">
                                        @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Acesso")
                                    </span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="background-color: var(--mgl-dark-primary);">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 text-white" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-graph-up me-2 text-info"></i> Dashboard KPIs
                                        </a>
                                    </li>
                                }
                                else if (User.IsInRole("Motorista"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 text-white" asp-controller="Entregas" asp-action="Index">
                                            <i class="bi bi-truck me-2 text-warning"></i> Minhas Entregas & POD
                                        </a>
                                    </li>
                                }
                                else if (User.IsInRole("Cliente"))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 text-white" asp-controller="ClientePortal" asp-action="Index">
                                            <i class="bi bi-person-workspace me-2 text-info"></i> Portal do Cliente
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i> Encerrar Sessão
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-mgl-primary btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-shield-lock me-1"></i> Entrar
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Alertas TempData -->
    <div class="container mt-3">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show card-mgl border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="fw-semibold">@TempData["MensagemSucesso"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["MensagemErro"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show card-mgl border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="fw-semibold">@TempData["MensagemErro"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Conteúdo Principal -->
    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <!-- Rodapé -->
    <footer class="border-top py-4 mt-auto" style="background-color: #FFFFFF;">
        <div class="container">
            <div class="row align-items-center gy-3 text-muted fs-7">
                <div class="col-md-6 text-center text-md-start">
                    <strong style="color: var(--mgl-dark-primary);">M.G.L Logística Integrada S.A.</strong> &copy; 2026 — Plataforma M.G.L Connect
                    <div class="text-secondary small">Solução Corporativa 3PL • Suporte a Roteamento Pesado • Proof of Delivery (POD) • SignalR</div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="badge border me-1" style="background-color: var(--mgl-bg); color: var(--mgl-accent-2);"><i class="bi bi-cpu"></i> .NET 10 MVC</span>
                    <span class="badge border me-1" style="background-color: var(--mgl-bg); color: var(--mgl-accent-2);"><i class="bi bi-broadcast"></i> SignalR Live</span>
                    <span class="badge border me-1" style="background-color: var(--mgl-bg); color: var(--mgl-accent-2);"><i class="bi bi-database"></i> SQLite / Neon PostgreSQL</span>
                    <span class="badge border" style="background-color: var(--mgl-bg); color: var(--mgl-accent-2);"><i class="bi bi-phone"></i> API Flutter</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts Base -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Microsoft SignalR JS Client para Atualizações em Tempo Real -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.25/signalr.min.js"></script>
    <!-- Leaflet JS para Mapas de Roteamento -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('[MGL PWA] Service Worker registrado:', reg.scope))
                    .catch(err => console.warn('[MGL PWA] Service Worker falhou:', err));
            });
        }
    </script>
</body>
</html>
