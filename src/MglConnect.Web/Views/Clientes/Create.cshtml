@model MglConnect.Web.Models.Cliente
@{
    ViewData["Title"] = "Cadastrar Cliente";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-building-add text-warning me-2"></i> Cadastro de Novo Cliente
                        </h4>
                        <p class="text-muted small mb-0">Preencha os dados cadastrais da empresa cliente.</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                </div>

                <form asp-action="Create" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 fs-7 mb-4" asp-validation-summary="All"></div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label asp-for="RazaoSocial" class="form-label fs-7 fw-semibold"></label>
                            <input asp-for="RazaoSocial" class="form-control" placeholder="Razão Social completa" required />
                            <span asp-validation-for="RazaoSocial" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="NomeFantasia" class="form-label fs-7 fw-semibold"></label>
                            <input asp-for="NomeFantasia" class="form-control" placeholder="Nome Fantasia comercial" />
                            <span asp-validation-for="NomeFantasia" class="text-danger fs-8"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Cnpj" class="form-label fs-7 fw-semibold"></label>
                            <input asp-for="Cnpj" class="form-control" placeholder="00.000.000/0000-00" required />
                            <span asp-validation-for="Cnpj" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Telefone" class="form-label fs-7 fw-semibold"></label>
                            <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" required />
                            <span asp-validation-for="Telefone" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label fs-7 fw-semibold"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="empresa@dominio.com.br" />
                            <span asp-validation-for="Email" class="text-danger fs-8"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">
                        <i class="bi bi-geo-alt text-primary me-1"></i> Endereço da Sede (Busca Automática por CEP)
                    </h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label asp-for="Cep" class="form-label fs-7 fw-semibold">CEP (digite para autocompletar)</label>
                            <div class="input-group">
                                <input asp-for="Cep" id="Cep" class="form-control" placeholder="00000-000" />
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            </div>
                            <span class="fs-8 text-muted">ViaCEP Integrado</span>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="Logradouro" class="form-label fs-7 fw-semibold">Logradouro / Rua</label>
                            <input asp-for="Logradouro" id="Logradouro" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Numero" class="form-label fs-7 fw-semibold">Número</label>
                            <input asp-for="Numero" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Complemento" class="form-label fs-7 fw-semibold">Complemento / Sala</label>
                            <input asp-for="Complemento" class="form-control" placeholder="Sala, Galpão..." />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Bairro" class="form-label fs-7 fw-semibold">Bairro</label>
                            <input asp-for="Bairro" id="Bairro" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Cidade" class="form-label fs-7 fw-semibold">Cidade</label>
                            <input asp-for="Cidade" id="Cidade" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Estado" class="form-label fs-7 fw-semibold">UF</label>
                            <input asp-for="Estado" id="Estado" class="form-control" maxlength="2" placeholder="SP" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4">
                            <i class="bi bi-check-lg me-1"></i> Salvar Cliente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            buscarCep('Cep', 'Logradouro', 'Bairro', 'Cidade', 'Estado');
        });
    </script>
}
