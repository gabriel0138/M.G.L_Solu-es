@model MglConnect.Web.Services.TruckRoutePlan
@using MglConnect.Web.Services
@{
    ViewData["Title"]="Roteamento";
    var state=ViewBag.RoutePresentation as RoutePresentation ?? RoutePresentation.From(Model);
    var deliveries=ViewBag.Entregas as List<MglConnect.Web.Models.Entrega> ?? new();
    var cost=ViewBag.CustoViagem as TripCostResult ?? new();
    int? selected=ViewBag.EntregaSelecionadaId as int?;
    var geo=ViewBag.GeographyContext as PlanningAddressContext;
    var editableStops=Model.ConfirmedStops.Count>=2 ? Model.ConfirmedStops : Model.RequestedStops.Select((p,i)=>new ConfirmedRouteStop(
        i==0 ? string.IsNullOrWhiteSpace(Model.Origem)?geo?.Origin??"Origem declarada":Model.Origem
        : i==Model.RequestedStops.Count-1 ? string.IsNullOrWhiteSpace(Model.Destino)?geo?.Destination??"Destino declarado":Model.Destino
        : $"Parada planejada {i}",p.Latitude,p.Longitude,"Manual",false,"Coordenada anterior; reconfirme no mapa")).ToList();
    var invariant=System.Globalization.CultureInfo.InvariantCulture;
}
<section class="cc-routing" id="routeResult" data-route-state="@state.State" data-has-geometry="@state.HasGeometry.ToString().ToLowerInvariant()">
    <header class="cc-routing-heading"><div><span class="cc-driver-eyebrow">Planejamento de viagem</span><h1>Roteamento</h1><p id="routeStateLabel" role="status">@state.Label</p></div>
        @if(selected.HasValue){<a class="btn btn-outline-secondary" href="/Entregas/Navegar/@selected">Abrir cockpit</a>}
    </header>
    @if(geo!=null && selected.HasValue){
        <form id="geographicPlanning" action="/Roteamento/Confirmar" method="post" class="cc-panel p-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="entregaId" value="@selected" /><input type="hidden" name="binding" value="@geo.Binding" />
            <h2>Confirmar pontos do pedido</h2><p class="small">Busque um endereço no Photon ou escolha no mapa. Confirmação do operador não garante precisão cadastral ou acesso de caminhão.</p>
            <div data-stops></div>
            <button id="addGeographicStop" type="button" class="btn btn-outline-secondary my-2">Adicionar parada</button>
            <p data-message role="status" class="small">A busca envia ao Photon somente o endereço consultado ao clicar.</p>
            <div class="cc-geographic-actions"><button id="previewConfirmedRoute" type="button" class="btn btn-outline-secondary" disabled>Pré-visualizar percurso</button><button id="saveConfirmedRoute" type="submit" class="btn btn-mgl-teal" disabled>Publicar planejamento confirmado</button><a id="viewDraftOnMap" class="btn btn-outline-secondary" href="#truckMap" hidden>Ver prévia no mapa</a></div>
            <p id="geographicPreview" role="status" class="small mt-2" hidden></p>
            <p class="small text-muted mb-0">Laranja tracejado: prévia não publicada. Verde: planejamento salvo. Ao publicar, o servidor recalcula o percurso. Caminhão não validado.</p>
        </form>
        <script id="geographyContext" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {origin=geo.Origin,destination=geo.Destination,currentDistanceKm=state.DistanceKm,stops=editableStops.Select(s=>new{address=s.Address,latitude=s.Latitude,longitude=s.Longitude,source=s.Source,candidateLabel=s.CandidateLabel})}))</script>
    }
    <details id="routeParameters" class="cc-route-parameters-panel" open><summary>Parâmetros do percurso</summary>
    <form method="get" id="rotaForm" class="cc-panel cc-route-parameters">
        <input type="hidden" name="calcular" value="true" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div><label for="routeProfile">Perfil solicitado</label><select id="routeProfile" class="form-select" name="perfilVeiculo"><option value="Pesado" selected="@(Model.PerfilVeiculo!="Leve")">Caminhão / carga pesada</option><option value="Leve" selected="@(Model.PerfilVeiculo=="Leve")">Leve / genérico</option></select></div>
        <div><label for="routeDelivery">Entrega própria</label><select id="routeDelivery" class="form-select" name="entregaId"><option value="">Informar percurso</option>@foreach(var delivery in deliveries){<option value="@delivery.Id" selected="@(selected==delivery.Id)">@delivery.CodigoRastreio</option>}</select></div>
        <div><label for="routeOrigin">Origem</label><input id="routeOrigin" class="form-control" name="origem" value="@Model.Origem" placeholder="Endereço de origem" /></div>
        <div><label for="routeDestination">Destino</label><input id="routeDestination" class="form-control" name="destino" value="@Model.Destino" placeholder="Endereço de destino" /></div>
        <div class="cc-route-wide"><label for="routeCoordinates">Coordenadas opcionais: longitude,latitude; longitude,latitude (2 a 10 paradas)</label><input id="routeCoordinates" class="form-control" name="coordenadas" value="@Context.Request.Query["coordenadas"]" placeholder="Use somente locais autorizados" /></div>
        <details class="cc-route-wide"><summary>Hipóteses de custo e parâmetros informados</summary><div class="cc-route-cost-inputs">
            <div><label for="routeFuel">Combustível (R$/L)</label><input id="routeFuel" type="number" min="0.01" step="0.01" class="form-control" name="precoCombustivel" value="@cost.PrecoLitroCombustivel.ToString(invariant)" /></div>
            <div><label for="routeConsumption">Consumo (km/L)</label><input id="routeConsumption" type="number" min="0.01" step="0.01" class="form-control" name="consumoKmL" value="@cost.ConsumoKmL.ToString(invariant)" /></div>
            <div><label for="routeAxles">Eixos informados</label><input id="routeAxles" type="number" min="1" max="20" class="form-control" name="eixos" value="@(Model.EixosVeiculo>0?Model.EixosVeiculo:5)" /></div>
        </div><p>Valores informados não são validação do veículo. Pedágio fixo do modelo: R$ 18,50 por eixo; não consultado nas praças da rota.</p></details>
        <button class="btn btn-mgl-teal" type="submit" id="calculateRoute">Calcular rota</button>
    </form></details>
    @if(ViewBag.HistoricalCaptureEnabled is true){<a href="/Roteamento?calcular=true&amp;coordenadas=-46.6559%2C-23.5614%3B-46.6333%2C-23.5505&amp;perfilVeiculo=Pesado" class="btn btn-outline-secondary my-2 cc-route-capture-link">Abrir captura histórica MASP → Praça da Sé</a>}
    @if(selected.HasValue){
        <form id="deliveryRoadPlanForm" method="post" action="/Roteamento/Planejar" class="cc-panel p-3 mb-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="entregaId" value="@selected" />
            <label for="deliveryRoadLocations">Planejamento vinculado à entrega · coordenadas declaradas (longitude,latitude)</label>
            <input id="deliveryRoadLocations" name="coordenadas" class="form-control my-2" required value="@(string.Join(";",Model.RequestedStops.Select(p=>$"{p.Longitude.ToString(invariant)},{p.Latitude.ToString(invariant)}")))" placeholder="Origem; paradas opcionais; destino" />
            <button id="saveDeliveryRoadPlan" type="submit" class="btn btn-mgl-teal">Calcular e vincular à entrega</button>
            <p class="small mb-0 mt-2">Confirme as coordenadas do pedido. O cálculo genérico não verifica acesso de caminhões.</p>
            @if(Model.PlanningId.HasValue){<p id="linkedRoadPlan" data-plan-id="@Model.PlanningId" data-revision="@Model.PlanRevision">Versão @Model.PlanRevision · planejamento @Model.PlanningId · calculado @Model.CalculatedAtUtc?.ToString("u") · validade @Model.ValidUntilUtc?.ToString("u")</p>}
        </form>
    }
    <div class="cc-routing-notice" role="status">@state.Notice</div>
    <p class="cc-routing-source" id="routeSource">@(state.GeometrySource switch {"HistoricalRoadCapture"=>"Captura viária histórica OSRM · não reconsultada · duração original desconhecida", "LocalProviderFixture"=>"Resposta de provedor local simulado · métricas de teste", "SyntheticCircuit"=>"Circuito sintético autorado · não representa ruas reais", "RoadNetwork"=>"Resposta do provedor rodoviário configurado", _=>state.HasGeometry?"Fonte de geometria não documentada":"Sem fonte de geometria utilizável"})</p>
    <dl class="cc-routing-metrics">
        <div><dt>@(geo!=null?"Distância do planejamento salvo":"Distância do percurso")</dt><dd id="routeDistance">@(state.DistanceKm.HasValue?$"{state.DistanceKm:N2} km":"—")</dd></div>
        <div><dt>@(geo!=null?"Duração do planejamento salvo":"Duração do provedor")</dt><dd id="routeDuration">@(state.DurationSeconds.HasValue?$"{Math.Ceiling(state.DurationSeconds.Value/60):N0} min":"—")</dd></div>
        <div><dt>Combustível estimado</dt><dd id="routeFuelCost">@(state.FuelCost.HasValue?$"R$ {state.FuelCost:N2}":"—")</dd></div>
        <div><dt>Pedágio da rota</dt><dd id="routeToll">—</dd><small>Não consultado</small></div>
        <div><dt>Cenário com pedágio fixo</dt><dd id="routeScenarioCost">@(state.ScenarioCost.HasValue?$"R$ {state.ScenarioCost:N2}":"—")</dd><small>Hipótese, não orçamento</small></div>
    </dl>
    <div class="cc-routing-map-panel cc-panel"><div class="cc-routing-map-heading"><h2>Geometria do percurso</h2><span id="routeGeometryCount">@(state.HasGeometry?Model.TrajetoCoordenadas.Count:0) vértices · não são amostras GPS</span></div><p id="routeMapStatus" role="status">@(state.HasGeometry?"Carregando mapa…":"Nenhuma rota disponível para desenhar.")</p><div id="geographicPreviewMap" hidden><p class="small text-warning">Prévia laranja não publicada; os indicadores acima são do planejamento salvo.</p><a href="#geographicPreview" class="btn btn-outline-secondary">Voltar à confirmação</a></div><div id="truckMap" role="region" aria-label="Mapa do percurso planejado"></div></div>
    <details class="cc-panel cc-route-diagnostics"><summary>Confiança, provedor e restrições</summary><dl><dt>Provedor / perfil</dt><dd>@state.Provider / @state.Profile</dd><dt>Resultado do provedor</dt><dd>@Model.ProviderFailure</dd><dt>Origem da geometria</dt><dd>@state.GeometrySource</dd><dt>SHA256 da evidência</dt><dd>@(Model.ProviderResponseSha256??"Indisponível")</dd><dt>Motor</dt><dd>@(Model.EngineVersion??"Não informado")</dd><dt>Dados públicos</dt><dd>@(Model.DatasetReference??"Não documentados")</dd><dt>Alternativas retornadas</dt><dd>@Model.AlternativeCount</dd><dt>Paradas localizadas pelo provedor</dt><dd>@Model.ProviderWaypoints.Count</dd><dt>Versão da malha</dt><dd>@(Model.ProviderGraphVersion??"Não informada")</dd><dt>Orientação pesada</dt><dd>@(Model.Confianca?.NavigationAllowed==true ? "Verificação limitada ao escopo registrado; não é homologação independente." : "Suspensa sem evidência suficiente de restrições e vínculo ao veículo.")</dd></dl>
        @if(selected.HasValue){<a href="/Rotas/Entrega/@selected" class="btn btn-outline-secondary">Avaliar perfil e restrições da entrega</a>}
        @foreach(var group in Model.Alertas.GroupBy(a=>a.Severidade).OrderBy(g=>g.Key=="Perigo"?0:1)){<h3>@group.Key</h3>@foreach(var alert in group){<p>@alert.Mensagem</p>}}
        @if(!string.IsNullOrWhiteSpace(Model.AvisoRota)){<p>@Model.AvisoRota</p>}
    </details>
</section>
@section Styles {<link rel="stylesheet" href="~/css/command-routing.css" asp-append-version="true" />}
@section Scripts {
<script id="routePresentation" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {state=state.State.ToString(),hasGeometry=state.HasGeometry,coordinates=state.HasGeometry?Model.TrajetoCoordenadas:new List<RouteCoordinate>(),stops=ViewBag.RouteStops as List<MglConnect.Web.Services.RouteTrust.RouteLocation>??Model.RequestedStops.Select(p=>new MglConnect.Web.Services.RouteTrust.RouteLocation(p.Latitude,p.Longitude)).ToList(),provider=state.Provider,profile=state.Profile,source=state.GeometrySource,distanceKm=state.DistanceKm,durationSeconds=state.DurationSeconds,routeToll=state.RouteToll,fuelCost=state.FuelCost,fixedTollScenario=state.FixedTollScenario,scenarioCost=state.ScenarioCost}))</script>
<script src="~/js/route-planning.js" asp-append-version="true"></script>
<script src="~/js/geographic-planning.js" asp-append-version="true"></script>
}
