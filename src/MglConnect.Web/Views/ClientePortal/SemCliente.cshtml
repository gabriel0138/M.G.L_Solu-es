@{
    ViewData["Title"] = "Portal do Cliente";
}

<div class="container py-5 text-center">
    <div class="card-mgl p-5 max-w-lg mx-auto">
        <div class="display-3 text-warning mb-3">
            <i class="bi bi-person-x"></i>
        </div>
        <h4 class="fw-bold" style="color: var(--mgl-dark-primary);">Nenhum Cliente Vinculado</h4>
        <p class="text-muted small mb-4">
            Cadastre um cliente no painel administrativo para visualizar o portal corporativo dedicado.
        </p>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-mgl-primary btn-sm px-4">Voltar ao Início</a>
        </div>
    </div>
</div>
