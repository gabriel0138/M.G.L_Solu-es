@model IEnumerable<MglConnect.Web.Models.Pedido>
@{
    ViewData["Title"] = "Meus pedidos";
    var cliente = ViewBag.Cliente as MglConnect.Web.Models.Cliente;
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var pedidos = Model.ToList();
    string? statusSelecionado = ViewBag.StatusSelecionado;
    string? termoBusca = ViewBag.TermoBusca;
    var filtrosAtivos = !string.IsNullOrWhiteSpace(statusSelecionado) || !string.IsNullOrWhiteSpace(termoBusca);
}

<div class="cc-dashboard cc-portal">
    <header class="cc-section-heading cc-page-heading">
        <div>
            <span class="cc-eyebrow">COMMAND CENTER / PORTAL DO CLIENTE</span>
            <h1>Meus pedidos</h1>
            <p>Solicitações de @(cliente?.NomeFantasia ?? cliente?.RazaoSocial ?? "sua conta"), do registro à conclusão da entrega.</p>
        </div>
        <div class="cc-quick-actions">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-grid" aria-hidden="true"></i> Visão geral</a>
            <a asp-action="NovoPedido" class="btn btn-mgl-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Novo pedido</a>
        </div>
    </header>

    <form method="get" asp-action="Pedidos" class="cc-filter-bar cc-portal-filters" aria-label="Filtrar seus pedidos">
        <div class="cc-portal-search">
            <label for="portalOrderSearch" class="form-label">Buscar pedido ou rastreio</label>
            <input id="portalOrderSearch" type="search" name="termo" value="@termoBusca" class="form-control" placeholder="Número, descrição da carga ou código de rastreio" maxlength="255" />
        </div>
        <div>
            <label for="portalOrderStatus" class="form-label">Estado do pedido ou da viagem</label>
            <select id="portalOrderStatus" name="status" class="form-select">
                <option value="">Todos os estados</option>
                <option value="Registrado" selected="@(statusSelecionado == "Registrado")">Pedido registrado</option>
                <option value="EmProcessamento" selected="@(statusSelecionado == "EmProcessamento")">Pedido em processamento</option>
                <option value="ComEntregaAtribuida" selected="@(statusSelecionado == "ComEntregaAtribuida")">Pedido em despacho</option>
                <option value="Pendente" selected="@(statusSelecionado == "Pendente")">Viagem pendente</option>
                <option value="Em transporte" selected="@(statusSelecionado == "Em transporte")">Viagem em transporte</option>
                <option value="Entregue" selected="@(statusSelecionado == "Entregue")">Entrega concluída</option>
                <option value="Concluido" selected="@(statusSelecionado == "Concluido")">Pedido concluído</option>
                <option value="Cancelado" selected="@(statusSelecionado == "Cancelado")">Pedido cancelado</option>
            </select>
        </div>
        <button type="submit" class="btn btn-mgl-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button>
        @if (filtrosAtivos)
        {
            <a asp-action="Pedidos" class="btn btn-link">Limpar filtros</a>
        }
        <p class="cc-filter-help">A busca e o estado são combinados e consideram somente os pedidos da sua conta.</p>
    </form>

    <section class="cc-panel cc-portal-results" aria-labelledby="portalOrdersHeading">
        <header class="cc-panel-header">
            <div>
                <h2 id="portalOrdersHeading">@(filtrosAtivos ? "Resultado da consulta" : "Histórico de pedidos")</h2>
                <p>@pedidos.Count @(pedidos.Count == 1 ? "pedido encontrado" : "pedidos encontrados") · Datas de criação em UTC</p>
            </div>
            <span class="cc-portal-scope"><i class="bi bi-shield-check" aria-hidden="true"></i> Sua conta corporativa</span>
        </header>
        @if (pedidos.Count == 0)
        {
            <div class="cc-empty-state">
                <i class="bi @(filtrosAtivos ? "bi-search" : "bi-box-seam")" aria-hidden="true"></i>
                <h3>@(filtrosAtivos ? "Nenhum pedido corresponde aos filtros" : "Você ainda não tem pedidos")</h3>
                <p>@(filtrosAtivos ? "Tente outro número, descrição ou código de rastreio, ou consulte todos os estados." : "Crie sua primeira solicitação com os dados da carga, da coleta e do destino.")</p>
                @if (filtrosAtivos)
                {
                    <a asp-action="Pedidos" class="btn btn-outline-secondary">Ver todos os pedidos</a>
                }
                else
                {
                    <a asp-action="NovoPedido" class="btn btn-mgl-primary">Criar primeiro pedido</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive cc-portal-table" role="region" aria-label="Seus pedidos, role horizontalmente para consultar todas as colunas" tabindex="0">
                <table class="table table-hover align-middle mb-0">
                    <caption class="visually-hidden">Pedidos da sua conta. Valores declarados de mercadoria em reais; datas de criação em UTC.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Pedido / criação (UTC)</th>
                            <th scope="col">Carga / trajeto</th>
                            <th scope="col">Mercadoria / peso</th>
                            <th scope="col">Estado do envio</th>
                            <th scope="col">Rastreamento</th>
                            <th scope="col" class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pedidos)
                        {
                            var estado = p.Status == "Cancelado" ? p.Status : p.Entrega?.StatusEntrega ?? p.Status;
                            <tr>
                                <th scope="row">
                                    <a asp-action="PedidoDetalhes" asp-route-id="@p.Id" class="cc-portal-order-number">@p.NumeroPedido</a>
                                    <time class="cc-portal-cell-meta" datetime="@p.DataPedido.ToString("yyyy-MM-ddTHH:mm:ssZ")">@p.DataPedido.ToString("dd/MM/yyyy HH:mm")</time>
                                </th>
                                <td class="cc-portal-description">
                                    <span>@p.Descricao</span>
                                    @if (!string.IsNullOrWhiteSpace(p.OrigemCidade) && !string.IsNullOrWhiteSpace(p.DestinoCidade))
                                    {
                                        <span class="cc-portal-cell-meta">@p.OrigemCidade / @p.OrigemEstado <i class="bi bi-arrow-right" aria-hidden="true"></i> @p.DestinoCidade / @p.DestinoEstado</span>
                                    }
                                </td>
                                <td>
                                    <strong class="cc-portal-money">@p.ValorTotal.ToString("C", br)</strong>
                                    <span class="cc-portal-cell-meta">@p.PesoKg.ToString("N1", br) kg</span>
                                </td>
                                <td><partial name="_CommandStatus" model="estado" /></td>
                                <td>
                                    @if (p.Entrega != null)
                                    {
                                        <div class="cc-portal-tracking">
                                            <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@p.Entrega.CodigoRastreio" class="font-monospace" aria-label="Rastrear o pedido @p.NumeroPedido">@p.Entrega.CodigoRastreio</a>
                                            <button type="button" class="btn btn-outline-secondary btn-sm cc-portal-copy" data-tracking-code="@p.Entrega.CodigoRastreio" onclick="copiarCodigoRastreio(this.dataset.trackingCode, this)" aria-label="Copiar código de rastreio do pedido @p.NumeroPedido" title="Copiar código de rastreio">
                                                <i class="bi bi-clipboard" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="cc-portal-cell-meta">Disponível após o despacho</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="PedidoDetalhes" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm" aria-label="Ver detalhes do pedido @p.NumeroPedido">Detalhes <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <div class="cc-data-note"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Consulte os detalhes de cada pedido para ver a entrega e os comprovantes disponíveis. Valor da mercadoria é o valor declarado da carga.</p></div>
</div>
