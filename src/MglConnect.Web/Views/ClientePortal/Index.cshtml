@model IEnumerable<MglConnect.Web.Models.Pedido>
@{
    var intermediary = User.IsInRole("Intermediador");
    ViewData["Title"] = intermediary ? "Portal do intermediador" : "Portal do cliente";
}

<div class="cc-dashboard cc-portal">
    <header class="cc-section-heading cc-page-heading">
        <div>
            <span class="cc-eyebrow">@(intermediary ? "COMMAND CENTER / INTERMEDIADOR" : "COMMAND CENTER / PORTAL DO CLIENTE")</span>
            <h1>Suas operações, conectadas</h1>
            <p>@(intermediary ? "Crie e acompanhe pedidos exclusivamente do cliente vinculado à sua conta." : "Envie pedidos, acompanhe suas cargas e encontre o histórico das suas entregas.")</p>
        </div>
        <div class="cc-quick-actions">
            <a asp-action="Pedidos" class="btn btn-outline-secondary">
                <i class="bi bi-box-seam" aria-hidden="true"></i> Meus pedidos
            </a>
            <a asp-action="NovoPedido" class="btn btn-mgl-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Novo pedido
            </a>
        </div>
    </header>

    <p id="operationalRefreshStatus" class="cc-refresh-status" role="status" aria-live="polite">Atualização automática a cada 20 segundos enquanto esta tela estiver visível.</p>
    <div id="operationalPanel" data-refresh-url="@Url.Action("Painel")">
        <partial name="_ClientOperationsPanel" model="Model" />
    </div>
</div>
@section Scripts {
    <script src="~/js/operational-dashboard.js" asp-append-version="true"></script>
}
