@model MglConnect.Web.ViewModels.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Acesso ao Command Center";
}

<section class="cc-login" aria-label="Acesso ao M.G.L Connect">
    <aside class="cc-login-story" aria-labelledby="login-story-title">
        <div class="cc-login-mark">
            <i class="bi bi-box-seam" aria-hidden="true"></i>
            <span>M.G.L CONNECT</span>
        </div>
        <div>
            <p class="cc-eyebrow">Command Center</p>
            <h1 id="login-story-title">Uma operação.<br />Todos conectados.</h1>
            <p>Pedidos, despacho, viagens e entregas em um único lugar. Cada perfil com as informações e ações da sua operação.</p>
        </div>

        <ol class="cc-login-flow" aria-label="Etapas da operação logística">
            <li><i class="bi bi-box-seam" aria-hidden="true"></i><span>Pedido</span></li>
            <li><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Despacho</span></li>
            <li><i class="bi bi-truck" aria-hidden="true"></i><span>Viagem</span></li>
            <li><i class="bi bi-check2-circle" aria-hidden="true"></i><span>Entrega</span></li>
        </ol>
        <p class="cc-login-caption">Administração · Motoristas · Clientes corporativos</p>
    </aside>

    <div class="cc-login-panel">
        <header>
            <p class="cc-eyebrow">Bem-vindo ao M.G.L Connect</p>
            <h2>Acesso ao Command Center</h2>
            <p>Entre com suas credenciais para acessar seu ambiente de trabalho.</p>
        </header>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert" asp-validation-summary="All"></div>
        }

        <form asp-action="Login" method="post" asp-antiforgery="true" class="cc-login-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label asp-for="Login" class="form-label">Usuário</label>
                <input asp-for="Login" class="form-control" placeholder="Seu usuário de acesso" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="login-validation" required autofocus />
                <span id="login-validation" asp-validation-for="Login" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Senha" class="form-label">Senha</label>
                <div class="cc-password-control">
                    <input asp-for="Senha" type="password" class="form-control" placeholder="Sua senha" autocomplete="current-password" aria-describedby="password-validation" required />
                    <button type="button" class="cc-password-toggle" data-toggle-password="Senha" aria-controls="Senha" aria-pressed="false" aria-label="Mostrar senha">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span id="password-validation" asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="LembrarMe" class="form-check-input" />
                <label asp-for="LembrarMe" class="form-check-label">Manter conectado</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <span>Acessar plataforma</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </form>

        @if (HostEnvironment.IsDevelopment())
        {
            <details class="cc-demo-access">
                <summary><i class="bi bi-info-circle" aria-hidden="true"></i> Acessos de demonstração local</summary>
                <dl>
                    <div>
                        <dt>Administrador</dt>
                        <dd><code>admin</code> / <code>admin123</code></dd>
                    </div>
                    <div>
                        <dt>Motorista</dt>
                        <dd><code>carlos.motorista</code> / <code>motorista123</code></dd>
                    </div>
                    <div>
                        <dt>Cliente</dt>
                        <dd><code>cliente.demo</code> / <code>cliente123</code></dd>
                    </div>
                </dl>
            </details>
        }
    </div>
</section>
