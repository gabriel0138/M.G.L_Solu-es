@model MglConnect.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Central operacional";
}
<div class="cc-dashboard">
    <header class="cc-section-heading cc-page-heading">
        <div>
            <span class="cc-eyebrow">M.G.L CONNECT / COMMAND CENTER</span>
            <h1>Visão geral da operação</h1>
            <p>Pedidos, viagens e prioridades da sua organização em um só lugar.</p>
        </div>
        <div class="cc-quick-actions">
            <a asp-controller="Pedidos" asp-action="Create" class="btn btn-outline-secondary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Novo pedido
            </a>
            <a asp-controller="Entregas" asp-action="Create" class="btn btn-mgl-primary">
                <i class="bi bi-send" aria-hidden="true"></i> Despachar carga
            </a>
        </div>
    </header>

    <form method="get" class="cc-filter-bar" aria-label="Filtrar período operacional">
        <div>
            <label for="periodoDe" class="form-label">Criados a partir de (UTC)</label>
            <input type="date" id="periodoDe" name="de" value="@(Model.PeriodoInicio?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div>
            <label for="periodoAte" class="form-label">Até (UTC)</label>
            <input type="date" id="periodoAte" name="ate" value="@(Model.PeriodoFim?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <button type="submit" class="btn btn-mgl-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Aplicar período</button>
        <a asp-action="Index" class="btn btn-link">Todo o histórico</a>
        <p class="cc-filter-help">O período considera a criação dos pedidos e das viagens.</p>
    </form>

    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <p id="operationalRefreshStatus" class="cc-refresh-status" role="status" aria-live="polite">Atualização automática a cada 20 segundos enquanto esta tela estiver visível.</p>
    @if (ViewData.ModelState.IsValid)
    {
        <div id="operationalPanel" data-refresh-url="@Url.Action("Painel")">
            <partial name="_OperationalPanel" model="Model" />
        </div>
    }
</div>
@section Scripts {
    <script src="~/js/operational-dashboard.js" asp-append-version="true"></script>
}
