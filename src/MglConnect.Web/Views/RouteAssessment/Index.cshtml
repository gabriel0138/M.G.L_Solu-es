@model MglConnect.Web.ViewModels.RouteAssessmentViewModel
@using MglConnect.Web.Services.RouteTrust
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ ViewData["Title"]="Confiança da rota";var e=Model.Delivery;var a=Model.Assessment;
string Fact(Measure? m)=>m==null?"Não informado":$"{m.Value:N2} {m.Unit} · {m.Origin} · {m.Reference}";
string ProviderState(ProviderFailure f)=>f switch{ProviderFailure.None=>"Consulta técnica concluída",ProviderFailure.MissingVehicleData=>"Perfil incompleto ou fora do domínio suportado",ProviderFailure.MissingLocations=>"Localização dos endereços indisponível",ProviderFailure.NoCoverage=>"Sem percurso disponível",ProviderFailure.RateLimited=>"Limite de consultas atingido",ProviderFailure.Timeout=>"Tempo de resposta esgotado",ProviderFailure.InvalidResponse=>"Resposta não verificável",ProviderFailure.Disabled=>"Desativado",_=>"Fornecedor indisponível"};
string RuleName(RestrictionKind k)=>k switch{RestrictionKind.Height=>"Altura máxima",RestrictionKind.Width=>"Largura máxima",RestrictionKind.Length=>"Comprimento máximo",RestrictionKind.GrossWeight=>"Massa bruta máxima",RestrictionKind.AxleLoad=>"Carga máxima por eixo",RestrictionKind.AxleCount=>"Número de eixos",RestrictionKind.Category=>"Categoria do veículo",RestrictionKind.Access=>"Condições de acesso",RestrictionKind.Time=>"Janela de horário",RestrictionKind.Hazardous=>"Carga perigosa",_=>"Não reconhecida"}; }
<div class="cc-dashboard">
<header class="cc-section-heading cc-page-heading"><div><span class="cc-eyebrow">COMMAND CENTER / ROTAS</span><h1>Avaliação de restrições</h1><p>Viagem @e.CodigoRastreio · @(e.Veiculo?.Placa??"Sem veículo atribuído") · revisão da viagem @Model.Profile.Revision</p></div><a class="btn btn-outline-secondary" asp-controller="Entregas" asp-action="Details" asp-route-id="@e.Id">Voltar à entrega</a></header>
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<section class="cc-panel mb-4" id="routeTrustResult" data-calculation-id="@a?.CalculationId" data-confidence="@(a?.Confidence.ToString()??"SemAvaliacao")" data-obsolete="@(a?.Obsolete==true?"true":"false")"><header class="cc-panel-header"><div><h2>@(a==null?"Ainda não avaliada":a.Obsolete?"Avaliação obsoleta":a.Checks.Any(c=>c.Outcome==RestrictionOutcome.Incompativel)?"BLOQUEADA":a.Synthetic&&a.Confidence==RouteConfidence.Validada?"VALIDADA EM ENSAIO":a.Confidence.ToString().ToUpperInvariant())</h2><p>Dados ausentes nunca significam compatibilidade. Esta etapa não gera homologação automática.</p></div><form action="/Rotas/Entrega/@e.Id/Calcular" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-primary">Solicitar cálculo e avaliação</button></form></header><div class="cc-panel-body">
@if(a!=null){<p><strong>Orientação operacional:</strong> @(a.NavigationAllowed&&!a.Obsolete?"Permitida no escopo verificado":"Suspensa; consulte a operação")</p>
<p>Provedor: @a.Provider · Perfil: @a.RoutingProfile · Revisão da declaração avaliada: @a.VehicleVersion · Base geográfica: @(a.GeographicVersion??"Não identificada") · Território: @(a.Territory??"Cobertura não comprovada")</p><p>Calculada em @a.CalculatedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC · versão @a.CalculationVersion</p>
<details><summary>Dados considerados no cálculo</summary><p>Veículo #@a.VehicleId · placa no cálculo: @(a.VehiclePlate??"Não registrada") · revisão @a.VehicleVersion</p><dl>
<dt>Altura total</dt><dd>@Fact(a.Vehicle.Height)</dd><dt>Largura</dt><dd>@Fact(a.Vehicle.Width)</dd><dt>Comprimento</dt><dd>@Fact(a.Vehicle.Length)</dd><dt>Massa bruta</dt><dd>@Fact(a.Vehicle.Gross)</dd><dt>Eixos / composição / carga</dt><dd>@(a.Vehicle.Axles?.ToString()??"Não informado") · @a.Vehicle.Composition · @a.Vehicle.Cargo</dd>
</dl></details>
@if(a.ProviderReply is {} reply){<div class="alert alert-warning" id="providerCoverage" data-provider-state="@reply.Failure"><strong>Provedor experimental · @ProviderState(reply.Failure)</strong><p>@reply.Detail</p><p>Segmentos identificados: @reply.Segments.Count · versão do grafo: @(reply.GraphVersion??"Desconhecida") · sem cobertura legal comprovada.</p><ul>@foreach(var item in reply.Coverage){<li>@RuleName(item.Key): @item.Value</li>}</ul>@if(reply.RetryAfterSeconds.HasValue){<p>Espera indicada pelo fornecedor: @reply.RetryAfterSeconds segundos.</p>}</div>}
<details><summary>Identificadores e fontes</summary><p class="text-break">Cálculo: @a.CalculationId · Regras: @a.RulesVersion · Fonte: @a.SourceReference · Geometria: @a.GeometrySha256</p></details>
@if(a.Synthetic){<p class="alert alert-warning">ENSAIO SINTÉTICO — restrições fictícias e geometria gravada de marcos públicos, que não representa os endereços desta entrega. Sem autorização para navegação real.</p>}
@if(a.Geometry.Count>1){<div id="routeAssessmentMap" data-tiles="@(Configuration["Maps:TileUrl"]??"https://tile.openstreetmap.org/{z}/{x}/{y}.png")" data-attribution="@(Configuration["Maps:Attribution"]??"© OpenStreetMap contributors")" style="height:280px" role="region" aria-label="Geometria estimada do cálculo; não é GPS ao vivo"></div><script type="application/json" id="routeAssessmentGeometry">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(a.Geometry))</script><p>Geometria do cálculo; não representa GPS nem comprovação de restrições reais.</p>}
<ul>@foreach(var reason in a.Reasons){<li>@reason</li>}</ul>
@if(a.MissingData.Count>0){<p>Dados faltantes: @string.Join(", ",a.MissingData)</p>}
@if(a.EstimatedDistanceKm.HasValue){<p>Distância estimada: @a.EstimatedDistanceKm.Value.ToString("N2") km · tempo estimado do cálculo: @(a.EstimatedMinutes?.ToString()??"Indisponível") min. Não é ETA operacional autorizado.</p>}
<div class="table-responsive" role="region" aria-label="Restrições avaliadas" tabindex="0"><table class="table cc-restriction-table"><thead><tr><th scope="col">Regra</th><th scope="col">Resultado</th><th scope="col">Motivo</th><th scope="col">Fonte / segmento</th></tr></thead><tbody>@foreach(var check in a.Checks){<tr data-rule-outcome="@check.Outcome"><th scope="row">@RuleName(check.Kind)</th><td>@check.Outcome</td><td>@check.Reason</td><td>@(a.ProviderReply?.Provider??check.Source) · @check.Version · arestas @check.FirstEdge–@check.LastEdge</td></tr>}</tbody></table></div>
}else{<div class="cc-empty-state"><h3>Nenhuma avaliação registrada</h3>
@if(e.RotaCalculoAtualId.HasValue){<p class="text-break">Solicitação @e.RotaCalculoAtualId iniciada, sem resultado confirmado. Se houve falha, tente novamente.</p>}
<p>Preencha somente dados conhecidos e solicite o cálculo. Rota genérica não aprova caminhões.</p></div>}
</div></section>
@if(e.VeiculoId.HasValue&&e.StatusEntrega is not ("Entregue" or "Cancelada")){
<section class="cc-panel mb-4"><header class="cc-panel-header"><div><h2>Cadastro permanente do veículo</h2></div></header><div class="cc-panel-body"><p>Dimensões cadastradas: @e.Veiculo?.AlturaMetros m × @e.Veiculo?.LarguraMetros m × @e.Veiculo?.ComprimentoMetros m. Capacidade cadastrada: @e.Veiculo?.CapacidadeCargaKg kg. São dados declarados/legados; não comprovam o envelope carregado desta viagem.</p><a class="btn btn-outline-secondary" href="/Frota/Veiculo/@e.VeiculoId">Consultar cadastro e histórico do veículo</a></div></section>
<section class="cc-panel mb-4"><header class="cc-panel-header"><div><h2>Perfil operacional desta viagem</h2><p>Unidades: metros e quilogramas. Campos vazios permanecem desconhecidos. Dados salvos aqui são DECLARADOS; não representam vistoria independente. Valores antigos não são convertidos automaticamente para PBT/PBTC. Esta declaração pertence exclusivamente à viagem; o cadastro permanente do veículo não é alterado.</p></div></header><div class="cc-panel-body">
<form action="/Rotas/Entrega/@e.Id/Perfil" method="post" id="routeProfileForm">@Html.AntiForgeryToken()<input type="hidden" name="Revision" value="@Model.Profile.Revision" />
<div class="row g-3">
@foreach(var field in new[]{("Height","Altura total (m)"),("Width","Largura (m)"),("Length","Comprimento da composição (m)"),("Tare","Tara (kg)"),("Pbt","PBT efetivo declarado (kg)"),("Pbtc","PBTC efetivo declarado (kg)"),("Payload","Carga efetiva transportada (kg)")}){var value=Model.Profile.GetType().GetProperty(field.Item1)!.GetValue(Model.Profile);<div class="col-md-4"><label class="form-label" for="profile-@field.Item1">@field.Item2</label>@Html.TextBox(field.Item1, value is decimal number ? number.ToString(System.Globalization.CultureInfo.InvariantCulture) : "", new { id = "profile-" + field.Item1, type = "number", step = "0.01", min = field.Item1 == "Payload" ? "0" : "0.01", max = "1000000", @class = "form-control" })</div>}
<div class="col-md-4"><label for="profileAxles" class="form-label">Número de eixos</label><input id="profileAxles" name="Axles" type="number" min="1" max="30" value="@Model.Profile.Axles" class="form-control" /></div>
@foreach(var field in new[]{("Category","Categoria do veículo"),("Composition","Composição"),("Cargo","Tipo de carga"),("HazardClass","Classe perigosa, se aplicável"),("Permits","Autorizações especiais (separadas por ;)"),("AccessRequirements","Requisitos conhecidos de acesso"),("AxleLoadsKg","Cargas por eixo (kg; separadas por ;, decimal com ponto)")}){<div class="col-md-6"><label class="form-label" for="profile-@field.Item1">@field.Item2</label><input id="profile-@field.Item1" name="@field.Item1" maxlength="@(field.Item1 is "Permits" or "AxleLoadsKg"?1000:200)" value="@Model.Profile.GetType().GetProperty(field.Item1)!.GetValue(Model.Profile)" class="form-control" /></div>}
<div class="col-md-6"><label for="profileHazardous" class="form-label">Carga perigosa?</label><select id="profileHazardous" name="Hazardous" class="form-select"><option value="">Não informado</option><option value="false" selected="@(Model.Profile.Hazardous==false)">Declarada não perigosa</option><option value="true" selected="@(Model.Profile.Hazardous==true)">Declarada perigosa</option></select></div>
</div><button type="submit" class="btn btn-primary mt-3">Salvar declaração e invalidar avaliação anterior</button></form></div></section>}
<section class="cc-panel mb-4"><header class="cc-panel-header"><h2>Últimas 20 declarações da viagem</h2></header><div class="cc-panel-body">@if(Model.ProfileHistory.Count==0){<p>Nenhuma revisão própria registrada; declarações legadas permanecem preservadas no cadastro original.</p>}@foreach(var revision in Model.ProfileHistory){var declared=OperationalTruckProfile.Read(revision.PerfilJson);<details><summary>Revisão @revision.Revisao · @revision.CriadoEmUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC · veículo #@revision.VeiculoId · responsável #@revision.AtorUsuarioId</summary><p>Altura: @Fact(declared.Height) · carga: @Fact(declared.Payload) · massa bruta: @Fact(declared.Gross) · composição: @declared.Composition</p><p class="text-break">Identificador: @revision.Id · SHA256 da declaração: @RouteFingerprint.Hash(declared)</p></details>}</div></section>
<section class="cc-panel mb-4" id="brazilCoverageInventory"><header class="cc-panel-header"><h2>Inventário público de cobertura · piloto brasileiro</h2></header><div class="cc-panel-body"><p>@Model.Inventory.Territory · captura @Model.Inventory.CapturedAtUtc · @Model.Inventory.Ways vias OSM selecionadas, @Model.Inventory.Bridges com tag bridge e @Model.Inventory.Tunnels com tag tunnel.</p><p><strong>Presença de tags não comprova restrição, vigência ou liberação legal.</strong> Esta amostra não foi associada ao percurso nem a uma versão de grafo do provedor. Ausência permanece desconhecida.</p><details><summary>Disponibilidade de atributos por tipo</summary><div class="table-responsive" tabindex="0" role="region" aria-label="Inventário de atributos públicos"><table class="table"><thead><tr><th scope="col">Tipo</th><th scope="col">Vias com atributo</th><th scope="col">Vias sem informação</th></tr></thead><tbody>@foreach(var count in Model.Inventory.Counts){<tr><th scope="row">@RuleName(count.Kind)</th><td>@count.TaggedWays</td><td>@count.UnknownWays</td></tr>}</tbody></table></div><p class="text-break">Fonte pública: <a href="@Model.Inventory.Source" rel="noreferrer">OpenStreetMap API</a> · SHA256 da resposta: @Model.Inventory.ResponseSha256 · © OpenStreetMap contributors, ODbL 1.0.</p></details></div></section>
<section class="cc-panel"><header class="cc-panel-header"><h2>Histórico das últimas 20 avaliações</h2></header><div class="cc-panel-body"><ul>@foreach(var past in Model.History){<li>@past.CriadoEmUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC · <a class="text-break" href="/Rotas/Entrega/@e.Id?avaliacao=@past.Id">@past.Id</a> · @(past.Obsoleta?"Conflito durante cálculo":"Registro preservado; validade depende do vínculo atual")</li>}</ul></div></section>
</div>

@section Scripts{<script>
(()=>{const box=document.getElementById('routeAssessmentMap'),data=document.getElementById('routeAssessmentGeometry');if(!box||!data||!window.L)return;const points=JSON.parse(data.textContent).map(p=>[p.Latitude,p.Longitude]);const map=L.map(box,{scrollWheelZoom:false});L.tileLayer(box.dataset.tiles,{attribution:box.dataset.attribution}).addTo(map);const line=L.polyline(points,{color:getComputedStyle(document.documentElement).getPropertyValue('--mgl-accent-primary').trim()});line.addTo(map);map.fitBounds(line.getBounds(),{padding:[20,20]});})();
</script>}
