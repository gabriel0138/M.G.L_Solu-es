@model MglConnect.Web.ViewModels.FleetVehicleForm
@{ var edit = Model.Id > 0; ViewData["Title"] = edit ? "Editar veículo" : "Cadastrar veículo";
string NumberValue(string field, decimal value) => ViewData.ModelState.TryGetValue(field, out var state)
    ? state.AttemptedValue ?? "" : value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
@section Styles { <link rel="stylesheet" href="~/css/command-roster.css" asp-append-version="true" /> }
<div class="cc-roster">
<header class="cc-section-heading cc-page-heading"><div><span class="cc-eyebrow">COMMAND CENTER / FROTA</span><h1>@ViewData["Title"]</h1><p>Características cadastrais usadas para verificar a capacidade no despacho.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Frota e motoristas</a></header>
<form method="post" asp-action="@(edit ? "EditarVeiculo" : "NovoVeiculo")" asp-route-id="@(edit ? Model.Id : (int?)null)" class="cc-roster-form" id="fleetVehicleForm">
<input asp-for="Id" type="hidden" /><input asp-for="Selo" type="hidden" />
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<section class="cc-panel"><header class="cc-panel-header"><div><h2>Identificação e capacidade</h2><p>Use os dados verificados do veículo. Valores não informados de cadastros antigos podem ser preservados na edição.</p></div></header><div class="cc-panel-body"><div class="row g-3">
<div class="col-md-8"><label asp-for="Modelo" class="form-label">Modelo</label><input asp-for="Modelo" class="form-control" maxlength="80" required /><span asp-validation-for="Modelo" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Placa" class="form-label">Placa</label><input asp-for="Placa" class="form-control font-monospace" maxlength="10" required aria-describedby="plateHelp" /><small id="plateHelp" class="cc-roster-meta">Padrão ABC1234 ou ABC1D23. Placas antigas permanecem aceitas quando não alteradas.</small><span asp-validation-for="Placa" class="text-danger"></span></div>
<div class="col-sm-6"><label asp-for="CapacidadeCargaKg" class="form-label">Capacidade de carga (kg)</label><input value="@NumberValue(nameof(Model.CapacidadeCargaKg), Model.CapacidadeCargaKg)" asp-for="CapacidadeCargaKg" class="form-control" type="number" min="@(edit && Model.CapacidadeCargaKg == 0 ? "0" : "0.01")" max="99999999.99" step="0.01" inputmode="decimal" required /><span asp-validation-for="CapacidadeCargaKg" class="text-danger"></span></div>
<div class="col-sm-6"><label asp-for="PesoToneladas" class="form-label">Massa cadastrada (t; sem classificação PBT/PBTC)</label><input value="@NumberValue(nameof(Model.PesoToneladas), Model.PesoToneladas)" asp-for="PesoToneladas" class="form-control" type="number" min="@(edit && Model.PesoToneladas == 0 ? "0" : "0.01")" max="9999.99" step="0.01" inputmode="decimal" required /><span asp-validation-for="PesoToneladas" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="AlturaMetros" class="form-label">Altura total (m)</label><input value="@NumberValue(nameof(Model.AlturaMetros), Model.AlturaMetros)" asp-for="AlturaMetros" class="form-control" type="number" min="@(edit && Model.AlturaMetros == 0 ? "0" : "0.01")" max="999.99" step="0.01" inputmode="decimal" required /><span asp-validation-for="AlturaMetros" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="LarguraMetros" class="form-label">Largura total (m)</label><input value="@NumberValue(nameof(Model.LarguraMetros), Model.LarguraMetros)" asp-for="LarguraMetros" class="form-control" type="number" min="@(edit && Model.LarguraMetros == 0 ? "0" : "0.01")" max="999.99" step="0.01" inputmode="decimal" required /><span asp-validation-for="LarguraMetros" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="ComprimentoMetros" class="form-label">Comprimento total (m)</label><input value="@NumberValue(nameof(Model.ComprimentoMetros), Model.ComprimentoMetros)" asp-for="ComprimentoMetros" class="form-control" type="number" min="@(edit && Model.ComprimentoMetros == 0 ? "0" : "0.01")" max="999.99" step="0.01" inputmode="decimal" required /><span asp-validation-for="ComprimentoMetros" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="QtdEixos" class="form-label">Quantidade de eixos</label><input asp-for="QtdEixos" class="form-control" type="number" min="1" max="20" step="1" required /><span asp-validation-for="QtdEixos" class="text-danger"></span></div>
<div class="col-sm-8"><label asp-for="TipoCarga" class="form-label">Tipo de carga</label><input asp-for="TipoCarga" class="form-control" maxlength="50" required /><span asp-validation-for="TipoCarga" class="text-danger"></span></div>
</div></div></section>
<div class="cc-data-note"><i class="bi bi-info-circle" aria-hidden="true"></i><p>Durante uma atribuição ou turno ativo, apenas o modelo pode ser editado. A comparação de capacidade não homologa rotas nem restrições para caminhões.</p></div>
<div class="cc-roster-actions">@if (edit) { <a asp-action="EditarVeiculo" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Reabrir dados atuais</a> }<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary">Salvar veículo</button></div>
</form></div>
