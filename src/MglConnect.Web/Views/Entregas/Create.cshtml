@model MglConnect.Web.ViewModels.NovaEntregaViewModel
@{
    ViewData["Title"] = "Preparar despacho";
    var pedidos = ViewBag.PedidosDisponiveis as List<MglConnect.Web.Models.Pedido> ?? new List<MglConnect.Web.Models.Pedido>();
    var motoristas = ViewBag.Motoristas as List<MglConnect.Web.Models.Usuario> ?? new List<MglConnect.Web.Models.Usuario>();
    var veiculos = ViewBag.Veiculos as List<MglConnect.Web.Models.Veiculo> ?? new List<MglConnect.Web.Models.Veiculo>();
}

@section Styles { <link rel="stylesheet" href="~/css/command-orders.css" asp-append-version="true" /> }

<div class="cc-orders">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="cc-panel cc-panel-body">
                <div class="cc-section-heading cc-page-heading border-bottom pb-3">
                    <div>
                        <span class="cc-eyebrow">COMMAND CENTER / DESPACHO</span>
                        <h1 class="mb-1">
                            <i class="bi bi-box-seam text-warning me-2"></i> Preparar despacho
                        </h1>
                        <p class="text-muted small mb-0">Selecione um pedido e confira a atribuição e os dados de destino.</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                </div>

                <form asp-action="Create" method="post" id="dispatchOrderForm" class="cc-order-form">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 fs-7 mb-4" asp-validation-summary="All"></div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label for="selectPedidoDespacho" class="form-label fs-7 fw-semibold">Pedido a ser Despachado</label>
                            <select asp-for="PedidoId" id="selectPedidoDespacho" class="form-select" required>
                                <option value="">-- Selecione um Pedido --</option>
                                @foreach (var ped in pedidos)
                                {
                                    <option value="@ped.Id" data-peso="@ped.PesoKg.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(ped.Id == Model.PedidoId)">
                                        @ped.NumeroPedido — @(ped.Cliente?.NomeFantasia ?? ped.Cliente?.RazaoSocial) (@ped.PesoKg.ToString("F1") kg)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="PedidoId" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="MotoristaId" class="form-label fs-7 fw-semibold">Motorista Responsável</label>
                            <select asp-for="MotoristaId" class="form-select">
                                <option value="">Sem motorista atribuído</option>
                                @foreach (var mot in motoristas)
                                {
                                    <option value="@mot.Id" selected="@(mot.Id == Model.MotoristaId)">
                                        @mot.Nome
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="selectVeiculoFrota" class="form-label fs-7 fw-semibold">Veículo da operação</label>
                            <select asp-for="VeiculoId" id="selectVeiculoFrota" class="form-select">
                                <option value="">Sem veículo atribuído</option>
                                @foreach (var v in veiculos)
                                {
                                    <option value="@v.Id" data-capacidade="@v.CapacidadeCargaKg.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(v.Id == Model.VeiculoId)">
                                        @v.Modelo (@v.Placa)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div id="badgeSugestaoDespacho" class="cc-order-capacity" role="status" aria-live="polite">
                        <i class="bi bi-truck" aria-hidden="true"></i>
                        <span id="textoSugestaoDespacho">Selecione o pedido e o veículo para comparar peso e capacidade cadastrados.</span>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">
                        <i class="bi bi-person text-primary me-1"></i> Dados do Destinatário
                    </h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="DestinatarioNome" class="form-label fs-7 fw-semibold">Nome Completo / Empresa</label>
                            <input asp-for="DestinatarioNome" class="form-control" placeholder="Destinatário final" required />
                            <span asp-validation-for="DestinatarioNome" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="DestinatarioDocumento" class="form-label fs-7 fw-semibold">CPF ou CNPJ</label>
                            <input asp-for="DestinatarioDocumento" class="form-control" placeholder="000.000.000-00" />
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 mt-4">
                        <i class="bi bi-geo-alt text-primary me-1"></i> Endereço de Destino (ViaCEP Integrado)
                    </h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label asp-for="CepDestino" class="form-label fs-7 fw-semibold">CEP Destino</label>
                            <div class="input-group">
                                <input asp-for="CepDestino" id="CepDestino" class="form-control" placeholder="00000-000" required />
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            </div>
                            <span class="fs-8 text-muted">Autocompleta via API</span>
                            <span asp-validation-for="CepDestino" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="EnderecoDestino" class="form-label fs-7 fw-semibold">Logradouro</label>
                            <input asp-for="EnderecoDestino" id="EnderecoDestino" class="form-control" placeholder="Rua / Avenida..." required />
                            <span asp-validation-for="EnderecoDestino" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="NumeroDestino" class="form-label fs-7 fw-semibold">Número</label>
                            <input asp-for="NumeroDestino" class="form-control" placeholder="100" required />
                            <span asp-validation-for="NumeroDestino" class="text-danger fs-8"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="ComplementoDestino" class="form-label fs-7 fw-semibold">Complemento</label>
                            <input asp-for="ComplementoDestino" class="form-control" placeholder="Apto, Galpão..." />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="BairroDestino" class="form-label fs-7 fw-semibold">Bairro</label>
                            <input asp-for="BairroDestino" id="BairroDestino" class="form-control" required />
                            <span asp-validation-for="BairroDestino" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="CidadeDestino" class="form-label fs-7 fw-semibold">Cidade</label>
                            <input asp-for="CidadeDestino" id="CidadeDestino" class="form-control" required />
                            <span asp-validation-for="CidadeDestino" class="text-danger fs-8"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="EstadoDestino" class="form-label fs-7 fw-semibold">UF</label>
                            <input asp-for="EstadoDestino" id="EstadoDestino" class="form-control" maxlength="2" placeholder="SP" required />
                            <span asp-validation-for="EstadoDestino" class="text-danger fs-8"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="PrevisaoDias" class="form-label fs-7 fw-semibold">Prazo de Entrega (Dias)</label>
                            <input asp-for="PrevisaoDias" type="number" min="1" max="30" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Observacoes" class="form-label fs-7 fw-semibold">Observações Operacionais</label>
                            <input asp-for="Observacoes" class="form-control" placeholder="Ex: Deixar na portaria com fulano..." />
                        </div>
                    </div>

                    <div class="alert alert-info d-flex align-items-center gap-2 fs-7 py-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>
                            O código de rastreamento será gerado pelo servidor ao salvar. Confira motorista, veículo e destino antes de confirmar o despacho.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4">
                            <i class="bi bi-box-seam me-1"></i> Despachar & Gerar Rastreio
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            buscarCep('CepDestino', 'EnderecoDestino', 'BairroDestino', 'CidadeDestino', 'EstadoDestino');

        });
    </script>
    <script src="~/js/dispatch-capacity.js" asp-append-version="true"></script>
}
