@model IEnumerable<MglConnect.Web.Models.Entrega>
@{
    ViewData["Title"] = "Entregas e despacho";
    var entregas = Model.ToList();
    var termo = ViewBag.TermoBusca as string;
    var status = ViewBag.StatusSelecionado as string;
    var temFiltros = !string.IsNullOrWhiteSpace(termo) || !string.IsNullOrWhiteSpace(status);
}

<section aria-labelledby="deliveriesHeading">
    <header class="cc-section-heading">
        <div>
            <span class="cc-eyebrow">COMMAND CENTER / DESPACHO</span>
            <h1 id="deliveriesHeading">Entregas em operação</h1>
            <p>Conecte pedidos, motoristas e movimentações em uma única visão da sua organização.</p>
        </div>
        <div class="cc-quick-actions">
            <a asp-controller="Operacoes" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-map" aria-hidden="true"></i> Mapa operacional</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="AlertasEmergencia" class="btn btn-outline-danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Emergências</a>
                <a asp-action="Create" class="btn btn-mgl-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nova entrega</a>
            }
        </div>
    </header>

    <form method="get" asp-action="Index" class="cc-filter-bar" role="search" aria-label="Filtrar entregas">
        <div class="flex-grow-1">
            <label for="deliverySearch" class="form-label">Buscar entrega</label>
            <input id="deliverySearch" type="search" name="termo" value="@termo" class="form-control" placeholder="Código, pedido, destinatário ou cidade" />
        </div>
        <div>
            <label for="deliveryStatus" class="form-label">Estado da entrega</label>
            <select id="deliveryStatus" name="status" class="form-select">
                <option value="">Todos os estados</option>
                <option value="Pendente" selected="@(status == "Pendente")">Pendente</option>
                <option value="Em transporte" selected="@(status == "Em transporte")">Em transporte</option>
                <option value="Entregue" selected="@(status == "Entregue")">Entregue</option>
                <option value="Cancelada" selected="@(status == "Cancelada")">Cancelada</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-mgl-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button>
            @if (temFiltros)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar filtros</a>
            }
        </div>
    </form>

    <section class="cc-panel" aria-labelledby="deliveriesListHeading">
        <header class="cc-panel-header">
            <div>
                <h2 id="deliveriesListHeading">Controle de viagens</h2>
                <p>@entregas.Count @(entregas.Count == 1 ? "entrega exibida" : "entregas exibidas")@(temFiltros ? " com os filtros selecionados" : "")</p>
            </div>
            <a asp-controller="Pedidos" asp-action="Index">Consultar pedidos <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        </header>
        <div class="table-responsive" role="region" aria-label="Lista de entregas; deslize para consultar todas as colunas" tabindex="0">
            <table class="table table-hover align-middle mb-0">
                <caption>Abra a operação para gerenciar atribuições e eventos; o rastreio público exibe somente os dados autorizados.</caption>
                <thead>
                    <tr>
                        <th scope="col">Entrega</th>
                        <th scope="col">Destino</th>
                        <th scope="col">Pedido e cliente</th>
                        <th scope="col">Motorista</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Último evento</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (entregas.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="cc-empty-state">
                                    <i class="bi bi-truck" aria-hidden="true"></i>
                                    <strong>@(temFiltros ? "Nenhuma entrega para estes filtros" : "Nenhuma entrega registrada")</strong>
                                    <p>@(temFiltros ? "Altere a busca ou limpe os filtros para consultar as demais operações." : "Crie uma entrega para atribuir motorista, veículo e acompanhar a viagem.")</p>
                                    @if (temFiltros)
                                    {
                                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar filtros</a>
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Create" class="btn btn-mgl-primary btn-sm">Criar entrega</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var entrega in entregas)
                    {
                        var ultimoEvento = entrega.EventosRastreio.OrderByDescending(ev => ev.DataHora).FirstOrDefault();
                        <tr>
                            <th scope="row">
                                <a asp-action="Details" asp-route-id="@entrega.Id" class="font-monospace text-decoration-none">@entrega.CodigoRastreio</a>
                                <small class="d-block text-muted fw-normal">Criada em @entrega.DataCriacao.ToString("dd/MM/yyyy")</small>
                            </th>
                            <td>
                                <span class="fw-semibold d-block">@entrega.DestinatarioNome</span>
                                <small class="text-muted d-block">@entrega.CidadeDestino/@entrega.EstadoDestino</small>
                                <small class="text-muted">CEP: @entrega.CepDestino</small>
                            </td>
                            <td>
                                @if (entrega.Pedido != null)
                                {
                                    <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@entrega.Pedido.Id" class="font-monospace text-decoration-none">@entrega.Pedido.NumeroPedido</a>
                                    <small class="d-block text-muted">@(entrega.Pedido.Cliente?.NomeFantasia ?? entrega.Pedido.Cliente?.RazaoSocial)</small>
                                }
                                else
                                {
                                    <small class="text-muted">Sem pedido vinculado</small>
                                }
                            </td>
                            <td>
                                @if (entrega.Motorista != null)
                                {
                                    <span class="d-block"><i class="bi bi-person" aria-hidden="true"></i> @entrega.Motorista.Nome</span>
                                }
                                else
                                {
                                    <span class="cc-status" data-status="warning">Sem motorista</span>
                                }
                            </td>
                            <td><partial name="_CommandStatus" model="entrega.StatusEntrega" /></td>
                            <td>
                                @if (ultimoEvento != null)
                                {
                                    <span class="fw-semibold d-block">@ultimoEvento.Titulo</span>
                                    <small class="text-muted d-block">@ultimoEvento.Localidade</small>
                                    <small class="text-muted">@ultimoEvento.DataHora.ToString("dd/MM/yyyy HH:mm")</small>
                                }
                                else
                                {
                                    <small class="text-muted">Sem movimentações registradas</small>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@entrega.Id" class="btn btn-outline-secondary btn-sm text-nowrap" aria-label="Abrir operação @entrega.CodigoRastreio">Abrir operação</a>
                                    @if (entrega.StatusEntrega is "Pendente" or "Em transporte")
                                    {
                                        <a asp-action="Navegar" asp-route-id="@entrega.Id" class="btn btn-outline-secondary btn-sm" aria-label="Abrir navegação da entrega @entrega.CodigoRastreio" title="Navegação"><i class="bi bi-compass" aria-hidden="true"></i></a>
                                    }
                                    <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@entrega.CodigoRastreio" class="btn btn-outline-secondary btn-sm" aria-label="Abrir rastreio público da entrega @entrega.CodigoRastreio" title="Rastreio público"><i class="bi bi-geo-alt" aria-hidden="true"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
