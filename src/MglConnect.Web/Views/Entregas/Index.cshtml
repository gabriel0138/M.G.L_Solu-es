@model IEnumerable<MglConnect.Web.Models.Entrega>
@{
    ViewData["Title"] = "Gestão de Entregas & Rastreio";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-truck text-primary me-2"></i> Entregas & Rastreamento
            </h3>
            <p class="text-muted small mb-0">Gerencie códigos de rastreio, motoristas e movimentações operacionais.</p>
        </div>
        <div>
            @if (User.IsInRole("Admin"))
            {
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="AlertasEmergencia" class="btn btn-outline-danger fw-bold shadow-sm">
                        <i class="bi bi-exclamation-triangle me-1"></i> Alertas de emergência
                    </a>
                    <a asp-action="Create" class="btn btn-warning fw-bold shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> Despachar Nova Entrega
                    </a>
                </div>
            }
            else if (User.IsInRole("Motorista"))
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle p-2 fs-7">
                    <i class="bi bi-person-badge me-1"></i> Rota do Motorista: <strong>@User.Identity?.Name</strong>
                </span>
            }
        </div>
    </div>

    <!-- Barra de Filtro e Busca -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-4 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="termo" value="@ViewBag.TermoBusca" 
                           class="form-control border-start-0" 
                           placeholder="Buscar por código de rastreio, destinatário, cidade..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- Todos os Status --</option>
                    <option value="Pendente" selected="@(ViewBag.StatusSelecionado == "Pendente")">Pendente (No CD)</option>
                    <option value="Em transporte" selected="@(ViewBag.StatusSelecionado == "Em transporte")">Em transporte</option>
                    <option value="Entregue" selected="@(ViewBag.StatusSelecionado == "Entregue")">Entregue</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            </div>
        </form>
    </div>

    <!-- Tabela de Entregas -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light fs-8 text-uppercase text-secondary">
                    <tr>
                        <th>Código Rastreio</th>
                        <th>Destinatário / Endereço</th>
                        <th>Pedido Vinculado</th>
                        <th>Motorista</th>
                        <th>Status</th>
                        <th>Último Checkpoint</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody class="fs-7">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Nenhuma remessa encontrada para os filtros selecionados.
                            </td>
                        </tr>
                    }
                    @foreach (var e in Model)
                    {
                        var ultimoEvento = e.EventosRastreio.OrderByDescending(ev => ev.DataHora).FirstOrDefault();
                        <tr>
                            <td>
                                <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@e.CodigoRastreio" 
                                   class="fw-bold text-primary font-monospace text-decoration-none">
                                    <i class="bi bi-box-seam me-1"></i> @e.CodigoRastreio
                                </a>
                                <div class="fs-8 text-muted">Criado: @e.DataCriacao.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <strong class="text-dark d-block">@e.DestinatarioNome</strong>
                                <span class="text-muted fs-8">@e.CidadeDestino/@e.EstadoDestino • CEP: @e.CepDestino</span>
                            </td>
                            <td>
                                @if (e.Pedido != null)
                                {
                                    <span class="font-monospace fw-semibold text-secondary">@e.Pedido.NumeroPedido</span>
                                    <div class="fs-8 text-muted">@(e.Pedido.Cliente?.NomeFantasia ?? e.Pedido.Cliente?.RazaoSocial)</div>
                                }
                            </td>
                            <td>
                                @if (e.Motorista != null)
                                {
                                    <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i> @e.Motorista.Nome</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Sem motorista</span>
                                }
                            </td>
                            <td>
                                @if (e.StatusEntrega == "Entregue")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill"></i> Entregue
                                    </span>
                                }
                                else if (e.StatusEntrega == "Em transporte")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        <i class="bi bi-truck"></i> Em transporte
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-hourglass-split"></i> Pendente
                                    </span>
                                }
                            </td>
                            <td>
                                @if (ultimoEvento != null)
                                {
                                    <div class="fw-semibold text-dark fs-8">@ultimoEvento.Titulo</div>
                                    <div class="text-muted fs-8">@ultimoEvento.Localidade • @ultimoEvento.DataHora.ToString("dd/MM HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted fs-8">Sem movimentações</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Navegar" asp-route-id="@e.Id" class="btn btn-warning text-dark fw-bold" title="Navegação GPS / Cockpit Waze">
                                        <i class="bi bi-compass"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-secondary" title="Gerenciar Checkpoints">
                                        <i class="bi bi-gear"></i>
                                    </a>
                                    <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@e.CodigoRastreio" 
                                       class="btn btn-outline-info text-dark" title="Visualização Cliente (Mercado Livre)">
                                        <i class="bi bi-geo-alt-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
