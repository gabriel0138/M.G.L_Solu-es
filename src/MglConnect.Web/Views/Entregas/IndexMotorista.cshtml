@model IReadOnlyList<MglConnect.Web.ViewModels.MotoristaViagemViewModel>
@{
    ViewData["Title"] = "Minhas viagens";
    var nome = User.Identity?.Name ?? "Motorista";
    var turnosAtivos = Model.Count(viagem => viagem.TurnoAtivo);
}

<section class="driver-home cc-driver-home" aria-labelledby="driverHomeTitle">
    <header class="cc-driver-heading">
        <div class="cc-driver-heading-copy">
            <span class="cc-driver-eyebrow"><i class="bi bi-compass" aria-hidden="true"></i> Área do motorista</span>
            <p class="cc-driver-greeting">Olá, @nome</p>
            <h1 id="driverHomeTitle">Minhas viagens</h1>
            <p>Confira sua atribuição e valide o turno para abrir a navegação.</p>
        </div>
        <div class="cc-driver-account-actions">
            <a asp-action="PerfilMotorista" class="btn btn-outline-secondary cc-driver-account-action">
                <i class="bi bi-person-circle" aria-hidden="true"></i><span>Meu perfil</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary cc-driver-account-action">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sair</span>
                </button>
            </form>
        </div>
    </header>

    <dl class="cc-driver-summary" aria-label="Resumo das suas atribuições">
        <div>
            <dt><i class="bi bi-truck-front" aria-hidden="true"></i> Viagens atribuídas</dt>
            <dd>@Model.Count</dd>
        </div>
        <div>
            <dt><i class="bi bi-key" aria-hidden="true"></i> Turnos ativos</dt>
            <dd>@turnosAtivos</dd>
        </div>
    </dl>

    @if (Model.Count == 0)
    {
        <section class="driver-empty-state cc-driver-empty" aria-labelledby="driverEmptyTitle">
            <span class="cc-driver-empty-icon"><i class="bi bi-truck-front" aria-hidden="true"></i></span>
            <h2 id="driverEmptyTitle">Nenhuma viagem atribuída</h2>
            <p>A operação ainda não atribuiu uma viagem ativa à sua conta. Quando receber uma atribuição, ela aparecerá aqui.</p>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Atualizar viagens</a>
        </section>
    }
    else
    {
        <section aria-labelledby="assigned-trips-heading">
            <div class="cc-driver-section-heading">
                <h2 id="assigned-trips-heading">Suas atribuições</h2>
                <a asp-action="Index" class="cc-driver-refresh"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Atualizar</a>
            </div>
            <div class="driver-trip-list">
                @foreach (var viagem in Model)
                {
                    var statusClass = viagem.Status switch
                    {
                        "Entregue" => "is-success",
                        "Cancelada" => "is-danger",
                        "Em transporte" => "is-info",
                        _ => "is-neutral"
                    };
                    <article class="driver-trip-card cc-driver-trip @(viagem.TurnoAtivo ? "cc-driver-trip-active" : "")" aria-labelledby="trip-title-@viagem.EntregaId">
                        <div class="cc-driver-trip-top">
                            <span class="cc-driver-trip-reference">Viagem #@viagem.EntregaId</span>
                            <span class="cc-driver-status @statusClass">@(string.IsNullOrWhiteSpace(viagem.Status) ? "Estado não informado" : viagem.Status)</span>
                        </div>
                        <div class="cc-driver-vehicle">
                            <span class="cc-driver-vehicle-icon"><i class="bi bi-truck-front" aria-hidden="true"></i></span>
                            <div class="cc-driver-vehicle-copy">
                                <span class="cc-driver-label">Veículo atribuído</span>
                                <h3 id="trip-title-@viagem.EntregaId">
                                    @(viagem.ModeloVeiculo ?? "Veículo pendente")
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(viagem.PlacaVeiculo))
                                {
                                    <span class="driver-plate">@viagem.PlacaVeiculo</span>
                                }
                            </div>
                        </div>

                        <div class="cc-driver-destination">
                            <span class="cc-driver-destination-icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                            <div>
                                <span class="cc-driver-label">Destino</span>
                                <p>@viagem.CidadeDestino / @viagem.EstadoDestino</p>
                            </div>
                        </div>

                        @if (viagem.TurnoAtivo)
                        {
                            <div class="cc-driver-shift-state is-active"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Turno ativo <small>Navegação liberada para esta viagem.</small></span></div>
                            <div class="cc-driver-trip-actions">
                                <a asp-action="Navegar" asp-route-id="@viagem.EntregaId" class="btn btn-driver-primary w-100">
                                    <i class="bi bi-compass-fill" aria-hidden="true"></i> Abrir navegação
                                </a>
                                <form asp-action="EncerrarTurno" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-stop-circle" aria-hidden="true"></i> Encerrar turno</button>
                                </form>
                            </div>
                        }
                        else if (viagem.VeiculoAtribuido)
                        {
                            <div class="cc-driver-shift-state"><i class="bi bi-lock" aria-hidden="true"></i><span>Aguardando validação <small>Use o código temporário fornecido pela operação.</small></span></div>
                            <form asp-action="IniciarTurno" method="post" class="cc-driver-shift-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="entregaId" value="@viagem.EntregaId" />
                                <label class="form-label" for="shift-code-@viagem.EntregaId">Código temporário do turno</label>
                                <input id="shift-code-@viagem.EntregaId" name="codigo" class="form-control"
                                       type="password" maxlength="100" autocomplete="one-time-code"
                                       autocapitalize="off" spellcheck="false" aria-describedby="shift-hint-@viagem.EntregaId" required />
                                <p id="shift-hint-@viagem.EntregaId" class="cc-driver-field-hint">O código autoriza o início do turno desta viagem.</p>
                                <button type="submit" class="btn btn-driver-primary w-100">
                                    <i class="bi bi-key-fill" aria-hidden="true"></i> Validar e iniciar turno
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="cc-driver-shift-state is-pending"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Aguardando veículo <small>A operação precisa atribuir um veículo antes do início do turno.</small></span></div>
                            <button type="button" class="btn btn-secondary w-100" disabled>Aguardando veículo atribuído</button>
                        }
                    </article>
                }
            </div>
        </section>
    }
</section>
