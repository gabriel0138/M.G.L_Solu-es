@model MglConnect.Web.ViewModels.CodigoTurnoViewModel
@{
    ViewData["Title"] = "Código temporário do turno";
}

<main class="container py-4">
    <section class="card-mgl p-4 mx-auto" style="max-width: 640px">
        <h1 class="h4 fw-bold">Código temporário de início de turno</h1>
        <p>Entrega #@Model.EntregaId · válido até @Model.ExpiraEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        <div class="alert alert-warning" role="alert">
            Entregue este código diretamente ao motorista atribuído. Ele é exibido somente nesta resposta, não é armazenado em texto puro e não deve ser compartilhado.
        </div>
        <output class="d-block text-center fs-4 font-monospace fw-bold p-3 border rounded bg-light"
                aria-label="Código temporário">@Model.Codigo</output>
        <form asp-action="CancelarCodigoTurno" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="entregaId" value="@Model.EntregaId" />
            <button type="submit" class="btn btn-outline-danger">Cancelar código se não for utilizado</button>
            <a asp-action="Details" asp-route-id="@Model.EntregaId" class="btn btn-outline-secondary">Voltar</a>
        </form>
    </section>
</main>
