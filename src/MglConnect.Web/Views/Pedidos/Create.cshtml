@model MglConnect.Web.Models.Pedido
@{ ViewData["Title"] = "Novo pedido"; }
@section Styles { <link rel="stylesheet" href="~/css/command-orders.css" asp-append-version="true" /> }
<div class="cc-orders">
    <header class="cc-section-heading cc-page-heading"><div><span class="cc-eyebrow">COMMAND CENTER / PEDIDOS</span><h1>Uma nova operação</h1><p>Cadastre a carga e os endereços para preparar o despacho.</p></div><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Todos os pedidos</a></header>
    <form asp-action="Create" method="post" id="adminOrderForm" class="cc-order-form">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <section class="cc-panel"><header class="cc-panel-header"><div><h2>1. Carga e cliente</h2><p>O código do pedido será gerado ao registrar a solicitação.</p></div></header><div class="cc-panel-body"><div class="row g-3">
            <div class="col-md-7"><label asp-for="ClienteId" class="form-label">Cliente solicitante</label><select asp-for="ClienteId" asp-items="ViewBag.ClienteId" class="form-select" required><option value="">Selecione um cliente ativo</option></select><span asp-validation-for="ClienteId" class="text-danger"></span></div>
            <div class="col-md-5"><label asp-for="TipoCarga" class="form-label">Tipo de carga</label><input asp-for="TipoCarga" class="form-control" maxlength="50" required /><span asp-validation-for="TipoCarga" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Descricao" class="form-label"></label><textarea asp-for="Descricao" class="form-control" rows="3" maxlength="255" required placeholder="Itens, quantidades e características da carga"></textarea><span asp-validation-for="Descricao" class="text-danger"></span></div>
            <div class="col-sm-6"><label asp-for="ValorTotal" class="form-label">Valor declarado da mercadoria (R$)</label><input asp-for="ValorTotal" type="number" min="0" max="100000000" step="0.01" inputmode="decimal" class="form-control" required /><span asp-validation-for="ValorTotal" class="text-danger"></span></div>
            <div class="col-sm-6"><label asp-for="PesoKg" class="form-label">Peso da carga (kg)</label><input asp-for="PesoKg" type="number" min="0.01" max="1000000" step="0.01" inputmode="decimal" class="form-control" required /><span asp-validation-for="PesoKg" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="AlturaCargaMetros" class="form-label">Altura (m · opcional)</label><input asp-for="AlturaCargaMetros" class="form-control" type="number" step="0.01" min="0.01" max="20" inputmode="decimal" /><span asp-validation-for="AlturaCargaMetros" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="LarguraCargaMetros" class="form-label">Largura (m · opcional)</label><input asp-for="LarguraCargaMetros" class="form-control" type="number" step="0.01" min="0.01" max="20" inputmode="decimal" /><span asp-validation-for="LarguraCargaMetros" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="ComprimentoCargaMetros" class="form-label">Comprimento (m · opcional)</label><input asp-for="ComprimentoCargaMetros" class="form-control" type="number" step="0.01" min="0.01" max="30" inputmode="decimal" /><span asp-validation-for="ComprimentoCargaMetros" class="text-danger"></span></div>
</div><p class="cc-order-hint">A atribuição de veículo acontece no despacho, conforme capacidade e condições da operação.</p></div></section>
<section class="cc-panel"><header class="cc-panel-header"><div><h2>2. Coleta</h2><p>Dados opcionais nesta etapa. Complete as informações disponíveis.</p></div></header><div class="cc-panel-body"><div class="row g-3">
<div class="col-sm-8"><label asp-for="OrigemEndereco" class="form-label">Logradouro</label><input asp-for="OrigemEndereco" class="form-control" maxlength="200" /><span asp-validation-for="OrigemEndereco" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="OrigemNumero" class="form-label">Número</label><input asp-for="OrigemNumero" class="form-control" maxlength="20" /><span asp-validation-for="OrigemNumero" class="text-danger"></span></div>
<div class="col-sm-6"><label asp-for="OrigemBairro" class="form-label">Bairro</label><input asp-for="OrigemBairro" class="form-control" maxlength="80" /><span asp-validation-for="OrigemBairro" class="text-danger"></span></div>
<div class="col-sm-6"><label asp-for="OrigemCidade" class="form-label">Cidade</label><input asp-for="OrigemCidade" class="form-control" maxlength="80" /><span asp-validation-for="OrigemCidade" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="OrigemEstado" class="form-label">UF</label><input asp-for="OrigemEstado" class="form-control" maxlength="2" pattern="[A-Za-z]{2}" /><span asp-validation-for="OrigemEstado" class="text-danger"></span></div>
<div class="col-sm-8"><label asp-for="OrigemCep" class="form-label">CEP</label><input asp-for="OrigemCep" class="form-control" maxlength="10" inputmode="numeric" /><span asp-validation-for="OrigemCep" class="text-danger"></span></div>
</div></div></section>
<section class="cc-panel"><header class="cc-panel-header"><div><h2>3. Destino</h2><p>Dados opcionais nesta etapa. Complete as informações disponíveis.</p></div></header><div class="cc-panel-body"><div class="row g-3">
<div class="col-sm-8"><label asp-for="DestinoEndereco" class="form-label">Logradouro</label><input asp-for="DestinoEndereco" class="form-control" maxlength="200" /><span asp-validation-for="DestinoEndereco" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="DestinoNumero" class="form-label">Número</label><input asp-for="DestinoNumero" class="form-control" maxlength="20" /><span asp-validation-for="DestinoNumero" class="text-danger"></span></div>
<div class="col-sm-6"><label asp-for="DestinoBairro" class="form-label">Bairro</label><input asp-for="DestinoBairro" class="form-control" maxlength="80" /><span asp-validation-for="DestinoBairro" class="text-danger"></span></div>
<div class="col-sm-6"><label asp-for="DestinoCidade" class="form-label">Cidade</label><input asp-for="DestinoCidade" class="form-control" maxlength="80" /><span asp-validation-for="DestinoCidade" class="text-danger"></span></div>
<div class="col-sm-4"><label asp-for="DestinoEstado" class="form-label">UF</label><input asp-for="DestinoEstado" class="form-control" maxlength="2" pattern="[A-Za-z]{2}" /><span asp-validation-for="DestinoEstado" class="text-danger"></span></div>
<div class="col-sm-8"><label asp-for="DestinoCep" class="form-label">CEP</label><input asp-for="DestinoCep" class="form-control" maxlength="10" inputmode="numeric" /><span asp-validation-for="DestinoCep" class="text-danger"></span></div>
</div></div></section>
<div class="cc-order-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Registrar pedido</button></div>
    </form>
</div>
