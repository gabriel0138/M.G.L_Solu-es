@using System.Globalization
@model IEnumerable<MglConnect.Web.Models.Pedido>
@{
    ViewData["Title"] = "Pedidos";
    var pedidos = Model.ToList();
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
    var termo = ViewBag.TermoBusca as string;
    var status = ViewBag.StatusSelecionado as string;
    var temFiltros = !string.IsNullOrWhiteSpace(termo) || !string.IsNullOrWhiteSpace(status);
}

<section aria-labelledby="ordersHeading">
    <header class="cc-section-heading">
        <div>
            <span class="cc-eyebrow">COMMAND CENTER / PEDIDOS</span>
            <h1 id="ordersHeading">Da solicitação ao despacho</h1>
            <p>Consulte as cargas da sua organização e acompanhe a preparação de cada operação.</p>
        </div>
        <div class="cc-quick-actions">
            <a asp-controller="Entregas" asp-action="Index" class="btn btn-outline-secondary">Ver entregas</a>
            <a asp-action="Create" class="btn btn-mgl-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Novo pedido</a>
        </div>
    </header>

    <form method="get" asp-action="Index" class="cc-filter-bar" role="search" aria-label="Filtrar pedidos">
        <div class="flex-grow-1">
            <label for="orderSearch" class="form-label">Buscar pedido</label>
            <input id="orderSearch" type="search" name="termo" value="@termo" class="form-control" placeholder="Número, cliente ou descrição da carga" />
        </div>
        <div>
            <label for="orderStatus" class="form-label">Estado do pedido</label>
            <select id="orderStatus" name="status" class="form-select">
                <option value="">Todos os estados</option>
                <option value="Registrado" selected="@(status == "Registrado")">Registrado</option>
                <option value="EmProcessamento" selected="@(status == "EmProcessamento")">Em processamento</option>
                <option value="ComEntregaAtribuida" selected="@(status == "ComEntregaAtribuida")">Em despacho</option>
                <option value="Concluido" selected="@(status == "Concluido")">Concluído</option>
                <option value="Cancelado" selected="@(status == "Cancelado")">Cancelado</option>
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-mgl-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrar</button>
            @if (temFiltros)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar filtros</a>
            }
        </div>
    </form>

    <section class="cc-panel" aria-labelledby="ordersListHeading">
        <header class="cc-panel-header">
            <div>
                <h2 id="ordersListHeading">Pedidos da operação</h2>
                <p>@pedidos.Count @(pedidos.Count == 1 ? "pedido exibido" : "pedidos exibidos")@(temFiltros ? " com os filtros selecionados" : "")</p>
            </div>
            <span class="cc-status">Valores declarados da carga</span>
        </header>
        <div class="table-responsive" role="region" aria-label="Lista de pedidos; deslize para consultar todas as colunas" tabindex="0">
            <table class="table table-hover align-middle mb-0">
                <caption>Valor da mercadoria é o valor declarado da carga, sem representar receita de frete.</caption>
                <thead>
                    <tr>
                        <th scope="col">Pedido</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Carga e percurso</th>
                        <th scope="col">Valor da mercadoria</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Despacho</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pedidos.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="cc-empty-state">
                                    <i class="bi bi-inbox" aria-hidden="true"></i>
                                    <strong>@(temFiltros ? "Nenhum pedido para estes filtros" : "Sua próxima operação começa aqui")</strong>
                                    <p>@(temFiltros ? "Altere a busca ou limpe os filtros para consultar os demais pedidos." : "Registre um pedido para preparar a carga e organizar o despacho.")</p>
                                    @if (temFiltros)
                                    {
                                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpar filtros</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Create" class="btn btn-mgl-primary btn-sm">Registrar pedido</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var pedido in pedidos)
                    {
                        var podeDespachar = pedido.Entrega == null && pedido.Status is "Registrado" or "EmProcessamento";
                        <tr>
                            <th scope="row">
                                <a asp-action="Details" asp-route-id="@pedido.Id" class="font-monospace text-decoration-none">@pedido.NumeroPedido</a>
                                <small class="d-block text-muted fw-normal">@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm", cultura)</small>
                            </th>
                            <td>
                                <span class="fw-semibold d-block">@(pedido.Cliente?.NomeFantasia ?? pedido.Cliente?.RazaoSocial ?? "Cliente não informado")</span>
                                <small class="text-muted">CNPJ: @(pedido.Cliente?.Cnpj ?? "não informado")</small>
                            </td>
                            <td>
                                <span class="d-block">@pedido.Descricao</span>
                                <small class="text-muted d-block">@pedido.PesoKg.ToString("N1", cultura) kg</small>
                                @if (!string.IsNullOrWhiteSpace(pedido.OrigemCidade) || !string.IsNullOrWhiteSpace(pedido.DestinoCidade))
                                {
                                    <small class="text-muted d-block">
                                        @(string.IsNullOrWhiteSpace(pedido.OrigemCidade) ? "Coleta não informada" : $"{pedido.OrigemCidade}/{pedido.OrigemEstado}")
                                        <span aria-label="para">→</span>
                                        @(string.IsNullOrWhiteSpace(pedido.DestinoCidade) ? "Destino não informado" : $"{pedido.DestinoCidade}/{pedido.DestinoEstado}")
                                    </small>
                                }
                            </td>
                            <td class="text-nowrap fw-semibold">@pedido.ValorTotal.ToString("C2", cultura)</td>
                            <td><partial name="_CommandStatus" model="pedido.Status" /></td>
                            <td>
                                @if (pedido.Entrega != null)
                                {
                                    <a asp-controller="Entregas" asp-action="Details" asp-route-id="@pedido.Entrega.Id" class="font-monospace text-decoration-none">@pedido.Entrega.CodigoRastreio</a>
                                    <small class="d-block text-muted">Entrega vinculada</small>
                                }
                                else if (podeDespachar)
                                {
                                    <a asp-controller="Entregas" asp-action="Create" asp-route-pedidoId="@pedido.Id" class="btn btn-mgl-primary btn-sm text-nowrap" aria-label="Despachar pedido @pedido.NumeroPedido"><i class="bi bi-truck" aria-hidden="true"></i> Despachar</a>
                                }
                                else
                                {
                                    <small class="text-muted">Sem entrega vinculada</small>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@pedido.Id" class="btn btn-outline-secondary btn-sm text-nowrap" aria-label="Ver pedido @pedido.NumeroPedido">Ver pedido</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
