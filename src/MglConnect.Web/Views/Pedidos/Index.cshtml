@model IEnumerable<MglConnect.Web.Models.Pedido>
@{
    ViewData["Title"] = "Gestão de Pedidos";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-receipt text-primary me-2"></i> Pedidos de Clientes
            </h3>
            <p class="text-muted small mb-0">Ordens de expedição registradas para transporte e distribuição.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-warning fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Registrar Novo Pedido
            </a>
        </div>
    </div>

    <!-- Tabela de Pedidos -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light fs-8 text-uppercase text-secondary">
                    <tr>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Itens / Descrição</th>
                        <th>Peso / Valor</th>
                        <th>Status</th>
                        <th>Rastreamento</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody class="fs-7">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Nenhum pedido encontrado.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark font-monospace">@p.NumeroPedido</strong>
                                <div class="fs-8 text-muted">@p.DataPedido.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(p.Cliente?.NomeFantasia ?? p.Cliente?.RazaoSocial)</div>
                                <div class="text-muted fs-8">CNPJ: @p.Cliente?.Cnpj</div>
                            </td>
                            <td>@p.Descricao</td>
                            <td>
                                <div><strong>R$ @p.ValorTotal.ToString("N2")</strong></div>
                                <span class="badge bg-light text-secondary border fs-8">@p.PesoKg.ToString("F1") kg</span>
                            </td>
                            <td>
                                @if (p.Status == "ComEntregaAtribuida")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        Em Despacho
                                    </span>
                                }
                                else if (p.Status == "Concluido")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        Concluído
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        Registrado
                                    </span>
                                }
                            </td>
                            <td>
                                @if (p.Entrega != null)
                                {
                                    <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@p.Entrega.CodigoRastreio" 
                                       class="badge bg-primary text-white text-decoration-none font-monospace p-2">
                                        <i class="bi bi-box-seam me-1"></i> @p.Entrega.CodigoRastreio
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Entregas" asp-action="Create" asp-route-pedidoId="@p.Id" 
                                       class="btn btn-warning btn-sm py-1 fs-8 fw-semibold">
                                        <i class="bi bi-truck me-1"></i> Despachar
                                    </a>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
