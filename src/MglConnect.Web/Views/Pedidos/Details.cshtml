@model MglConnect.Web.Models.Pedido
@{
    ViewData["Title"] = "Detalhes do Pedido " + Model.NumeroPedido;
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-receipt text-primary me-2"></i> Pedido @Model.NumeroPedido
            </h3>
            <p class="text-muted small mb-0">Registrado em @Model.DataPedido.ToString("dd/MM/yyyy às HH:mm")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Informações Gerais</h5>
                <ul class="list-unstyled fs-7 mb-0">
                    <li class="mb-2"><strong>Cliente:</strong> @(Model.Cliente?.RazaoSocial)</li>
                    <li class="mb-2"><strong>CNPJ do Cliente:</strong> @(Model.Cliente?.Cnpj)</li>
                    <li class="mb-2"><strong>Descrição / Conteúdo:</strong> @Model.Descricao</li>
                    <li class="mb-2"><strong>Valor Declarado:</strong> R$ @Model.ValorTotal.ToString("N2")</li>
                    <li class="mb-2"><strong>Peso Total:</strong> @Model.PesoKg.ToString("F1") kg</li>
                    <li class="mb-2"><strong>Status do Pedido:</strong> <span class="badge bg-primary">@Model.Status</span></li>
                </ul>
                @if (User.IsInRole("Admin") && Model.Entrega == null && Model.Status is "Registrado" or "EmProcessamento")
                {
                    <form asp-action="AtualizarStatus" method="post" class="mt-3 d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        @if (Model.Status == "Registrado")
                        {
                            <button class="btn btn-primary btn-sm" name="status" value="EmProcessamento">Validar pedido</button>
                        }
                        <button class="btn btn-outline-danger btn-sm" name="status" value="Cancelado">Cancelar pedido</button>
                    </form>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Expedição & Rastreio</h5>
                @if (Model.Entrega != null)
                {
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="text-muted fs-8">Código de Rastreamento Gerado:</div>
                        <div class="fs-4 fw-extrabold text-primary font-monospace">@Model.Entrega.CodigoRastreio</div>
                        <div class="fs-8 text-secondary mt-1">Status: <strong>@Model.Entrega.StatusEntrega</strong></div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@Model.Entrega.CodigoRastreio" 
                           class="btn btn-warning fw-bold">
                            <i class="bi bi-geo-alt-fill me-1"></i> Visualizar Rastreamento Estilo ML
                        </a>
                        <a asp-controller="Entregas" asp-action="Details" asp-route-id="@Model.Entrega.Id" 
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-gear me-1"></i> Gerenciar Despacho & Checkpoints
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-hourglass-split display-5 text-warning d-block mb-2"></i>
                        Este pedido ainda não possui uma remessa de entrega cadastrada.
                    </div>
                    <div class="d-grid">
                        <a asp-controller="Entregas" asp-action="Create" asp-route-pedidoId="@Model.Id" 
                           class="btn btn-warning fw-bold">
                            <i class="bi bi-truck me-1"></i> Criar Entrega & Gerar Código de Rastreio
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
