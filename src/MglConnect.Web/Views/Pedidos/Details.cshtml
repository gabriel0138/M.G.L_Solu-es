@model MglConnect.Web.Models.Pedido
@{
    ViewData["Title"] = "Pedido " + Model.NumeroPedido;
    var br = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var podeDespachar = Model.Entrega == null && (Model.Status is "Registrado" or "EmProcessamento");
}
@section Styles { <link rel="stylesheet" href="~/css/command-orders.css" asp-append-version="true" /> }
<div class="cc-orders">
    <header class="cc-section-heading cc-page-heading">
        <div><span class="cc-eyebrow">COMMAND CENTER / PEDIDOS</span><h1>Pedido @Model.NumeroPedido</h1><p>Registrado em @Model.DataPedido.ToString("dd/MM/yyyy HH:mm") UTC</p></div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Todos os pedidos</a>
    </header>
    <div class="cc-order-grid">
        <section class="cc-panel" aria-labelledby="orderCargoTitle">
            <header class="cc-panel-header"><h2 id="orderCargoTitle">Carga e solicitante</h2><partial name="_CommandStatus" model="Model.Status" /></header>
            <div class="cc-panel-body">
                <p class="cc-order-description">@Model.Descricao</p>
                <dl class="cc-order-data">
                    <div><dt>Cliente</dt><dd>@(Model.Cliente?.RazaoSocial ?? "Não informado")</dd></div>
                    <div><dt>CNPJ</dt><dd>@(Model.Cliente?.Cnpj ?? "Não informado")</dd></div>
                    <div><dt>Valor declarado da mercadoria</dt><dd>@Model.ValorTotal.ToString("C", br)</dd></div>
                    <div><dt>Peso da carga</dt><dd>@Model.PesoKg.ToString("N1", br) kg</dd></div>
                    <div><dt>Tipo de carga</dt><dd>@Model.TipoCarga</dd></div>
                    @if (Model.AlturaCargaMetros.HasValue) { <div><dt>Altura</dt><dd>@Model.AlturaCargaMetros.Value.ToString("N2", br) m</dd></div> }
                    @if (Model.LarguraCargaMetros.HasValue) { <div><dt>Largura</dt><dd>@Model.LarguraCargaMetros.Value.ToString("N2", br) m</dd></div> }
                    @if (Model.ComprimentoCargaMetros.HasValue) { <div><dt>Comprimento</dt><dd>@Model.ComprimentoCargaMetros.Value.ToString("N2", br) m</dd></div> }
                </dl>
                @if (podeDespachar)
                {
                    <form asp-action="AtualizarStatus" method="post" class="cc-order-actions">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        @if (Model.Status == "Registrado") { <button class="btn btn-primary" name="status" value="EmProcessamento">Validar pedido</button> }
                        <button class="btn btn-outline-danger" name="status" value="Cancelado">Cancelar pedido</button>
                    </form>
                }
            </div>
        </section>
        <section class="cc-panel" aria-labelledby="orderDispatchTitle">
            <header class="cc-panel-header"><h2 id="orderDispatchTitle">Despacho e acompanhamento</h2><i class="bi bi-truck" aria-hidden="true"></i></header>
            <div class="cc-panel-body">
                @if (Model.Entrega != null)
                {
                    <span class="cc-order-label">Entrega vinculada</span><p class="cc-order-reference">@Model.Entrega.CodigoRastreio</p>
                    <partial name="_CommandStatus" model="Model.Entrega.StatusEntrega" />
                    <div class="cc-order-actions mt-4">
                        <a asp-controller="Entregas" asp-action="Details" asp-route-id="@Model.Entrega.Id" class="btn btn-primary">Gerenciar entrega <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                        <a asp-controller="Rastreio" asp-action="Index" asp-route-codigo="@Model.Entrega.CodigoRastreio" class="btn btn-outline-secondary">Consulta pública</a>
                    </div>
                }
                else
                {
                    <div class="cc-order-empty"><i class="bi bi-box-seam" aria-hidden="true"></i><h3>Sem entrega vinculada</h3><p>@(podeDespachar ? "Confira os dados e selecione motorista e veículo para o despacho." : "Este pedido não está disponível para despacho no estado atual.")</p></div>
                    @if (podeDespachar) { <a asp-controller="Entregas" asp-action="Create" asp-route-pedidoId="@Model.Id" class="btn btn-primary">Preparar despacho <i class="bi bi-arrow-right" aria-hidden="true"></i></a> }
                }
            </div>
        </section>
        <section class="cc-panel" aria-labelledby="orderPickupTitle"><header class="cc-panel-header"><h2 id="orderPickupTitle">Coleta</h2><i class="bi bi-geo" aria-hidden="true"></i></header><div class="cc-panel-body">
            @if (!string.IsNullOrWhiteSpace(Model.OrigemEndereco)) { <address>@Model.OrigemEndereco, @Model.OrigemNumero<br />@Model.OrigemBairro<br />@Model.OrigemCidade / @Model.OrigemEstado<br />@Model.OrigemCep</address> }
            else { <p class="text-muted mb-0">Endereço de coleta não informado.</p> }
        </div></section>
        <section class="cc-panel" aria-labelledby="orderDestinationTitle"><header class="cc-panel-header"><h2 id="orderDestinationTitle">Destino solicitado</h2><i class="bi bi-geo-alt" aria-hidden="true"></i></header><div class="cc-panel-body">
            @if (!string.IsNullOrWhiteSpace(Model.DestinoEndereco)) { <address>@Model.DestinoEndereco, @Model.DestinoNumero<br />@Model.DestinoBairro<br />@Model.DestinoCidade / @Model.DestinoEstado<br />@Model.DestinoCep</address> }
            else { <p class="text-muted mb-0">Endereço de destino não informado no pedido. Confira os dados no despacho.</p> }
        </div></section>
    </div>
</div>
